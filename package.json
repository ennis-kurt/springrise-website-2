{
  "name": "springrise-website",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "db:migrate": "wrangler d1 migrations apply springrise --local",
    "db:migrate:remote": "wrangler d1 migrations apply springrise --remote",
    "deploy": "astro build && wrangler deploy",
    "check": "astro check",
    "db:seed-demo": "wrangler d1 execute springrise --local --file scripts/seed-demo.sql",
    "test:api": "node tests/api.test.mjs",
    "test:e2e": "node tests/e2e-apply.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/preact": "^6.0.5",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "^7.3.5",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260927.1",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.142.0"
  }
}
