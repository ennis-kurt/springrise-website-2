{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "springrise",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "d1_databases": [{ "binding": "DB", "database_name": "springrise", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "springrise-documents" }],
  "vars": { "SITE_NAME": "Springrise Foundation" }
}
