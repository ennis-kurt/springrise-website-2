---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";
import { NAV, ORG } from "../lib/content";
import { fmtShortDate } from "../lib/seasons";
import type { PublicSeason } from "../lib/site";

interface Props { current: PublicSeason | null; tone?: "paper" | "ink" }
const { current, tone = "paper" } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + "/");

const status = current
  ? current.state === "open"
    ? { dot: "open", text: `${current.term} ${current.year} applications open`, href: `/scholarships/${current.slug}` }
    : current.state === "upcoming"
      ? { dot: "upcoming", text: `${current.term} ${current.year} opens ${fmtShortDate(current.opens_at)}`, href: `/scholarships/${current.slug}` }
      : { dot: "closed", text: "Applications closed", href: "/scholarships" }
  : { dot: "closed", text: "Scholarships", href: "/scholarships" };
---
<header class:list={["site-header", `site-header--${tone}`]} data-header>
  <div class="container site-header__inner">
    <Logo tone={tone === "ink" ? "light" : "color"} />
    <nav class="site-nav" aria-label="Primary">
      <ul role="list">
        {NAV.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="site-header__actions">
      <a class="status-pill" href={status.href}>
        <span class:list={["dot", `dot--${status.dot}`]}></span>
        <span>{status.text}</span>
      </a>
      <a class="btn btn--sm btn--cobalt header-cta" href="/donate">
        <Icon name="heart" size={16} /> Give
      </a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
        <span class="visually-hidden">Open menu</span>
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden data-menu>
  <div class="mobile-menu__top container">
    <Logo tone="light" />
    <button class="menu-btn menu-btn--light" type="button" data-menu-close>
      <span class="visually-hidden">Close menu</span>
      <Icon name="close" size={26} />
    </button>
  </div>
  <nav class="container mobile-menu__nav" aria-label="Mobile">
    <ul role="list">
      <li><a href="/">Home</a></li>
      {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </nav>
  <div class="container mobile-menu__foot">
    <a class="status-pill status-pill--light" href={status.href}>
      <span class:list={["dot", `dot--${status.dot}`]}></span>
      <span>{status.text}</span>
    </a>
    <p><a href={`mailto:${ORG.emails.info}`}>{ORG.emails.info}</a><br /><a href={ORG.phoneHref}>{ORG.phone}</a></p>
  </div>
  <Mark size={420} tone="light" class="mobile-menu__mark" />
</div>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    transition: background-color 0.4s, box-shadow 0.4s, backdrop-filter 0.4s;
  }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; height: 5.25rem; }
  .site-header.is-scrolled { background: rgb(247 242 233 / 0.86); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px); box-shadow: 0 1px 0 var(--line); }
  .site-header--ink { color: var(--paper); }
  .site-header--ink.is-scrolled { background: rgb(13 23 51 / 0.88); box-shadow: 0 1px 0 rgb(255 255 255 / 0.08); }

  .site-nav ul { display: flex; gap: 0.25rem; }
  .site-nav a {
    position: relative; display: block; padding: 0.55rem 0.85rem; border-radius: var(--radius-pill);
    font-size: 0.95rem; font-weight: 450; text-decoration: none; transition: background-color 0.25s;
  }
  .site-nav a:hover { background: rgb(13 23 51 / 0.06); }
  .site-header--ink .site-nav a:hover { background: rgb(255 255 255 / 0.08); }
  .site-nav a[aria-current="page"]::after {
    content: ""; position: absolute; left: 50%; bottom: 0.2rem; width: 4px; height: 4px; margin-left: -2px;
    border-radius: 50%; background: var(--tulip);
  }

  .site-header__actions { display: flex; align-items: center; gap: 0.6rem; }
  .status-pill {
    display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.5rem 0.9rem 0.5rem 0.75rem;
    border-radius: var(--radius-pill); border: 1px solid var(--line-strong);
    font-size: 0.84rem; font-weight: 500; text-decoration: none; white-space: nowrap;
    transition: border-color 0.25s, background-color 0.25s;
  }
  .status-pill:hover { border-color: var(--ink); background: var(--white); }
  .site-header--ink .status-pill { border-color: rgb(255 255 255 / 0.25); }
  .site-header--ink .status-pill:hover { background: rgb(255 255 255 / 0.08); border-color: rgb(255 255 255 / 0.5); }
  .status-pill--light { color: var(--paper); border-color: rgb(255 255 255 / 0.3); }

  .menu-btn { display: none; width: 2.75rem; height: 2.75rem; border-radius: 50%; place-items: center; }
  .menu-btn:hover { background: rgb(13 23 51 / 0.06); }
  .menu-btn--light { color: var(--paper); display: grid; }

  @media (max-width: 1080px) {
    .site-nav { display: none; }
    .menu-btn { display: grid; }
  }
  @media (max-width: 640px) {
    .site-header__inner { height: 4.5rem; }
    .site-header__actions .status-pill, .header-cta { display: none; }
  }

  .mobile-menu {
    position: fixed; inset: 0; z-index: 80; background: var(--ink); color: var(--paper);
    display: flex; flex-direction: column; overflow: hidden auto;
    animation: menu-in 0.5s var(--ease);
  }
  @keyframes menu-in { from { clip-path: circle(0% at calc(100% - 3rem) 2.5rem); } to { clip-path: circle(150% at calc(100% - 3rem) 2.5rem); } }
  .mobile-menu__top { display: flex; justify-content: space-between; align-items: center; height: 4.5rem; }
  .mobile-menu__nav { flex: 1; display: flex; align-items: center; padding-block: 2rem; position: relative; z-index: 1; }
  .mobile-menu__nav a {
    display: block; font-family: var(--font-display); font-size: clamp(2.6rem, 11vw, 4.5rem); line-height: 1.08;
    text-decoration: none; letter-spacing: -0.02em; transition: color 0.2s, padding 0.3s var(--ease);
  }
  .mobile-menu__nav a:hover { color: var(--saffron); padding-left: 0.5rem; font-style: italic; }
  .mobile-menu__foot { display: flex; flex-wrap: wrap; gap: 1.5rem; justify-content: space-between; align-items: end; padding-bottom: 2rem; position: relative; z-index: 1; }
  .mobile-menu__foot p { font-size: 0.95rem; opacity: 0.8; }
  .mobile-menu__foot a { text-decoration: none; }
  .mobile-menu :global(.mobile-menu__mark) { position: absolute; right: -6rem; bottom: -4rem; opacity: 0.07; pointer-events: none; }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const menu = document.querySelector<HTMLElement>("[data-menu]");
  const openBtn = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-menu-close]");
  const setOpen = (open: boolean) => {
    if (!menu || !openBtn) return;
    menu.hidden = !open;
    openBtn.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
    (open ? closeBtn : openBtn)?.focus();
  };
  openBtn?.addEventListener("click", () => setOpen(true));
  closeBtn?.addEventListener("click", () => setOpen(false));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && menu && !menu.hidden) setOpen(false); });
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
</script>
