---
// Closing call-to-action band used at the bottom of interior pages.
import Icon from "./Icon.astro";
import TilePattern from "./TilePattern.astro";
interface Props {
  title: string;
  accent?: string;
  body?: string;
  primary: { href: string; label: string };
  secondary?: { href: string; label: string };
}
const { title, accent, body, primary, secondary } = Astro.props;
---
<section class="cta-band">
  <div class="container">
    <div class="cta-band__card reveal">
      <TilePattern id="cta-tile" color="var(--paper)" opacity={0.12} />
      <div class="cta-band__text">
        <h2 class="h2">{title}{accent && <> <em>{accent}</em></>}</h2>
        {body && <p class="lead">{body}</p>}
      </div>
      <div class="cta-band__actions">
        <a class="btn btn--light btn--lg" href={primary.href}>{primary.label} <Icon name="arrow" size={18} /></a>
        {secondary && <a class="btn btn--ghost-light btn--lg" href={secondary.href}>{secondary.label}</a>}
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band { padding-block: clamp(3rem, 6vw, 6rem); }
  .cta-band__card {
    position: relative; overflow: hidden; display: grid; grid-template-columns: 1.4fr auto; gap: 2rem; align-items: end;
    padding: clamp(2rem, 5vw, 4.5rem); border-radius: var(--radius-lg);
    background: radial-gradient(120% 140% at 100% 100%, var(--cobalt) 0%, var(--cobalt-deep) 45%, var(--ink) 100%);
    color: var(--paper);
  }
  .cta-band__text, .cta-band__actions { position: relative; }
  .cta-band h2 { max-width: 14em; }
  .cta-band h2 em { color: var(--saffron); }
  .cta-band .lead { margin-top: 1rem; color: rgb(247 242 233 / 0.75); }
  .cta-band__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  @media (max-width: 860px) { .cta-band__card { grid-template-columns: 1fr; } }
</style>
