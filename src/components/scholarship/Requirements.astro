---
// Eligibility, documents and award terms. Uses the season's own text when provided, else verified defaults.
import Icon from "../Icon.astro";
import { DEFAULT_ELIGIBILITY, DEFAULT_REQUIREMENTS, DOCUMENTS, MAX_FILE_BYTES } from "../../lib/content";
import { lines } from "../../lib/seasons";
interface Props { eligibility?: string; requirements?: string }
const eligibility = lines(Astro.props.eligibility).length ? lines(Astro.props.eligibility) : DEFAULT_ELIGIBILITY;
const terms = lines(Astro.props.requirements).length ? lines(Astro.props.requirements) : DEFAULT_REQUIREMENTS;
---
<section class="req section" id="eligibility">
  <div class="container req__grid">
    <header class="req__head">
      <p class="eyebrow reveal">Who can apply</p>
      <h2 class="h1 reveal" style="--d:.06s">Eligibility</h2>
      <p class="muted reveal" style="--d:.12s">Criteria can vary with available funds and the foundation's annual objectives. When in doubt, <a href="mailto:scholarship@springrise.org">ask us</a>.</p>
    </header>
    <ol class="req__list" role="list">
      {eligibility.map((e, i) => (
        <li class="reveal" style={`--d:${i * 0.04}s`}><span class="req__n">{String(i + 1).padStart(2, "0")}</span><p>{e}</p></li>
      ))}
    </ol>
  </div>
</section>

<section class="req section section--paper2" id="documents">
  <div class="container req__grid">
    <header class="req__head">
      <p class="eyebrow reveal">What you'll need</p>
      <h2 class="h1 reveal" style="--d:.06s">Documents</h2>
      <p class="muted reveal" style="--d:.12s">Prepare these as PDFs (up to {Math.round(MAX_FILE_BYTES / 1024 / 1024)} MB each) before you start. You'll also need contact details for two references who aren't relatives.</p>
    </header>
    <ul class="docs" role="list">
      {DOCUMENTS.map((d, i) => (
        <li class:list={["doc reveal", !d.required && "doc--optional"]} style={`--d:${i * 0.04}s`}>
          <span class="doc__icon"><Icon name="file" size={22} /></span>
          <div>
            <p class="doc__title">{d.label}{!d.required && <span class="chip">Optional</span>}</p>
            <p class="doc__help">{d.help}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="req section" id="terms">
  <div class="container req__grid">
    <header class="req__head">
      <p class="eyebrow reveal">How awards work</p>
      <h2 class="h1 reveal" style="--d:.06s">Award terms</h2>
      <p class="muted reveal" style="--d:.12s">The Board of Directors sets each award. Amounts vary with socioeconomic challenges, financial need, academic performance, tuition cost, references and community engagement.</p>
    </header>
    <ul class="terms" role="list">
      {terms.map((t, i) => (
        <li class="reveal" style={`--d:${i * 0.04}s`}><Icon name="check" size={20} /><p>{t}</p></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .req__grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(2rem, 6vw, 7rem); align-items: start; }
  .req__head { position: sticky; top: 7rem; display: grid; gap: 1.1rem; }
  .req__head a { color: var(--cobalt); }
  .req__list { list-style: none; padding: 0; border-top: 1px solid var(--line-strong); }
  .req__list li { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1rem; padding: 1.35rem 0; border-bottom: 1px solid var(--line-strong); font-size: 1.08rem; }
  .req__n { font-family: var(--font-display); font-size: 1.9rem; line-height: 1; color: var(--tulip); }
  .docs { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.85rem; }
  .doc { display: grid; grid-template-columns: auto 1fr; gap: 1rem; padding: 1.35rem; border-radius: var(--radius); background: var(--white); border: 1px solid var(--line); }
  .doc--optional { background: transparent; border-style: dashed; }
  .doc__icon { display: grid; place-items: center; width: 2.9rem; height: 2.9rem; border-radius: 50%; background: var(--paper-2); color: var(--cobalt); }
  .doc__title { font-weight: 600; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .doc__title .chip { font-size: 0.6rem; padding: 0.2rem 0.5rem; }
  .doc__help { color: var(--text-muted); font-size: 0.93rem; margin-top: 0.25rem; }
  .terms { list-style: none; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--line-strong); }
  .terms li { display: grid; grid-template-columns: 2rem 1fr; gap: 0.9rem; padding: 1.2rem 0; border-bottom: 1px solid var(--line-strong); }
  .terms li :global(svg) { color: var(--turquoise); margin-top: 0.2rem; }
  @media (max-width: 900px) {
    .req__grid { grid-template-columns: 1fr; }
    .req__head { position: static; }
  }
  @media (max-width: 600px) { .docs { grid-template-columns: 1fr; } }
</style>
