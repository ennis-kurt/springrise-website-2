---
// Generative, data-driven art. Each stem is one scholar Springrise has supported.
// Stems grow in, sway gently, and lean toward the pointer like plants turning to light.
// All pointer response is eased per stem and per frame, so motion stays smooth.
interface Group { count: number; color: string; label?: string; weight?: number }
interface Props { groups: Group[]; class?: string; density?: number; tone?: "light" | "dark" }
const { groups, class: cls = "", density = 1, tone = "light" } = Astro.props;
---
<div class:list={["field", cls]}>
  <canvas data-field data-groups={JSON.stringify(groups)} data-density={density} data-tone={tone} aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;display:block"></canvas>
</div>

<style>
  .field { position: absolute; inset: 0; pointer-events: none; }
</style>

<script>
  type Group = { count: number; color: string; weight?: number };
  type Stem = { x: number; h: number; lean: number; phase: number; speed: number; width: number; color: string; alpha: number; delay: number; leaf: number; near: number };
  type Mote = { x: number; y: number; r: number; v: number; a: number; p: number };

  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const rng = (seed: number) => () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
  const rgba = (hex: string, a: number) => {
    const n = parseInt(hex.slice(1), 16);
    return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`;
  };
  // frame-rate independent easing: k is the fraction covered per 1/60 s
  const ease = (from: number, to: number, k: number, dt: number) => from + (to - from) * (1 - Math.pow(1 - k, dt * 60));

  document.querySelectorAll<HTMLCanvasElement>("canvas[data-field]").forEach((canvas) => {
    const ctx = canvas.getContext("2d")!;
    const groups: Group[] = JSON.parse(canvas.dataset.groups || "[]");
    const density = Number(canvas.dataset.density || 1);
    const dark = canvas.dataset.tone === "dark";
    let W = 0, H = 0;
    let stems: Stem[] = [];
    let motes: Mote[] = [];
    let t0 = performance.now(), last = t0;
    const target = { x: 0, on: 0 };
    const eased = { x: 0, on: 0 };
    let running = true;

    function build() {
      const rand = rng(20250625);
      const total = groups.reduce((n, g) => n + g.count, 0);
      const slots = Array.from({ length: total }, (_, i) => i).sort(() => rand() - 0.5);
      let k = 0;
      stems = [];
      groups.forEach((g, gi) => {
        for (let i = 0; i < g.count; i++) {
          const slot = slots[k++];
          const x = ((slot + 0.5 + (rand() - 0.5) * 0.8) / total) * W;
          const zone = W > 900 ? 0.45 + 0.55 * Math.min(1, Math.max(0, (x / W - 0.3) / 0.4)) : 0.55;
          stems.push({
            x, h: H * Math.min(0.8, (g.weight ?? 1) * (0.38 + rand() * 0.42) * zone),
            lean: (rand() - 0.5) * 0.14, phase: rand() * Math.PI * 2, speed: 0.22 + rand() * 0.22,
            width: (gi === 0 ? 2.2 : 1.7) * (0.85 + rand() * 0.4), color: g.color, alpha: gi === 0 ? 0.95 : 0.75,
            delay: 200 + slot * 34 + rand() * 260, leaf: 0.5 + rand() * 0.3, near: 0,
          });
        }
      });
      motes = Array.from({ length: Math.round(28 * density * (W / 1400 + 0.3)) }, () => ({
        x: rand() * W, y: rand() * H, r: 0.8 + rand() * 1.8, v: 5 + rand() * 10, a: 0.18 + rand() * 0.35, p: rand() * 6,
      }));
    }

    function resize() {
      const r = canvas.getBoundingClientRect();
      const dpr = Math.min(2, devicePixelRatio || 1);
      W = r.width; H = r.height;
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      build();
      if (reduce) draw(performance.now() + 1e6, 0);
    }

    function leaf(x: number, y: number, size: number, angle: number) {
      ctx.save(); ctx.translate(x, y); ctx.rotate(angle);
      ctx.beginPath(); ctx.moveTo(0, 0);
      ctx.quadraticCurveTo(size * 0.55, -size * 0.48, size, 0);
      ctx.quadraticCurveTo(size * 0.55, size * 0.48, 0, 0);
      ctx.fill(); ctx.restore();
    }

    function draw(now: number, dt: number) {
      const t = (now - t0) / 1000;
      ctx.clearRect(0, 0, W, H);

      // soft sunlight near the ground
      const g = ctx.createRadialGradient(W * 0.65, H * 1.1, 0, W * 0.65, H * 1.1, Math.max(W, H) * 0.8);
      g.addColorStop(0, dark ? "rgba(240,180,76,0.18)" : "rgba(240,180,76,0.22)");
      g.addColorStop(1, "rgba(240,180,76,0)");
      ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);

      // drifting seeds
      for (const m of motes) {
        if (!reduce) {
          m.y -= (m.v * dt);
          m.x += Math.sin(t * 0.5 + m.p) * 0.12;
          if (m.y < -4) { m.y = H + 4; m.x = Math.random() * W; }
        }
        ctx.globalAlpha = m.a * (0.35 + 0.65 * (m.y / H));
        ctx.fillStyle = dark ? "#fffcf6" : "#b4502d";
        ctx.beginPath(); ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2); ctx.fill();
      }
      ctx.globalAlpha = 1;

      // pointer, eased
      eased.x = ease(eased.x, target.x, 0.06, dt);
      eased.on = ease(eased.on, target.on, 0.04, dt);
      const lean = ((eased.x / (W || 1)) - 0.5) * 2 * eased.on;

      for (const s of stems) {
        const age = Math.max(0, (now - t0 - s.delay) / 1800);
        const grow = reduce ? 1 : 1 - Math.pow(1 - Math.min(1, age), 3);
        if (grow <= 0) continue;
        const nearTarget = Math.max(0, 1 - Math.abs(eased.x - s.x) / (W * 0.22)) * eased.on;
        s.near = ease(s.near, nearTarget, 0.05, dt);
        const h = s.h * grow;
        const sway = reduce ? 0 : Math.sin(t * s.speed + s.phase) * 0.04 + Math.sin(t * s.speed * 1.7 + s.phase) * 0.012;
        const bend = (s.lean + sway + lean * 0.16 + s.near * lean * 0.12) * h;
        const tipX = s.x + bend, tipY = H - h;
        const cx = s.x + bend * 0.15, cy = H - h * 0.55;

        const grad = ctx.createLinearGradient(0, H, 0, tipY);
        grad.addColorStop(0, rgba(s.color, 0));
        grad.addColorStop(0.3, rgba(s.color, 0.35 * s.alpha));
        grad.addColorStop(1, rgba(s.color, s.alpha));
        ctx.strokeStyle = grad; ctx.lineWidth = s.width; ctx.lineCap = "round";
        ctx.beginPath(); ctx.moveTo(s.x, H + 2); ctx.quadraticCurveTo(cx, cy, tipX, tipY); ctx.stroke();

        const lt = s.leaf;
        const lx = (1 - lt) ** 2 * s.x + 2 * (1 - lt) * lt * cx + lt * lt * tipX;
        const ly = (1 - lt) ** 2 * H + 2 * (1 - lt) * lt * cy + lt * lt * tipY;
        const size = Math.min(15, 5 + h * 0.03) * grow;
        ctx.fillStyle = rgba(s.color, 0.6 * s.alpha);
        leaf(lx, ly, size, -0.9 + bend / h);
        leaf(lx, ly, size * 0.8, Math.PI + 0.9 + bend / h);

        // bud: a soft halo that swells gently when the pointer is near
        const halo = (7 + s.near * 9) * (reduce ? 1 : 0.92 + 0.08 * Math.sin(t * 1.2 + s.phase));
        const rg = ctx.createRadialGradient(tipX, tipY, 0, tipX, tipY, halo * 2.4);
        rg.addColorStop(0, rgba(s.color, 0.32 + s.near * 0.2));
        rg.addColorStop(1, rgba(s.color, 0));
        ctx.fillStyle = rg; ctx.beginPath(); ctx.arc(tipX, tipY, halo * 2.4, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = rgba(s.color, s.alpha);
        ctx.beginPath(); ctx.arc(tipX, tipY, s.width * 1.7 + s.near * 1.2, 0, Math.PI * 2); ctx.fill();
      }
    }

    function loop(now: number) {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      if (running) draw(now, dt);
      requestAnimationFrame(loop);
    }

    const host = canvas.closest("section") ?? canvas.parentElement!;
    host.addEventListener("pointermove", (e) => {
      const r = canvas.getBoundingClientRect();
      target.x = e.clientX - r.left; target.on = 1;
    });
    host.addEventListener("pointerleave", () => (target.on = 0));
    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver(([e]) => (running = e.isIntersecting)).observe(canvas);
    document.addEventListener("visibilitychange", () => (running = !document.hidden));
    resize();
    eased.x = target.x = W / 2;
    t0 = last = performance.now();
    if (!reduce) requestAnimationFrame(loop);
  });
</script>
