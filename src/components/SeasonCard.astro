---
// Live scholarship-season status card (open / upcoming / closed).
import Icon from "./Icon.astro";
import { daysUntil, fmtDate } from "../lib/seasons";
import type { PublicSeason } from "../lib/site";
interface Props { season: PublicSeason | null; hasNext?: boolean; variant?: "float" | "flat" }
const { season, hasNext = false, variant = "float" } = Astro.props;
const state = season?.state ?? "closed";
const days = season ? (state === "open" ? daysUntil(season.closes_at) : state === "upcoming" ? daysUntil(season.opens_at) : 0) : 0;
---
<div class:list={["season-card", `season-card--${state}`, `season-card--${variant}`]}>
  <div class="season-card__top">
    <span class="season-card__status"><span class:list={["dot", `dot--${state}`]}></span>
      {state === "open" ? "Applications open" : state === "upcoming" ? "Opening soon" : "Applications closed"}
    </span>
    {season && state !== "closed" && (
      <span class="season-card__days"><b>{days}</b> {days === 1 ? "day" : "days"} {state === "open" ? "left" : "to go"}</span>
    )}
  </div>
  {season ? (
    <>
      <p class="season-card__title">{season.term} {season.year} <em>Tuition Scholarship</em></p>
      <p class="season-card__meta">
        {state === "open" && <>Apply by <strong>{fmtDate(season.closes_at)}</strong></>}
        {state === "upcoming" && <>Opens <strong>{fmtDate(season.opens_at)}</strong> · closes {fmtDate(season.closes_at)}</>}
        {state === "closed" && (hasNext ? <>This season has closed.</> : <>The next season will be announced soon.</>)}
      </p>
      <div class="season-card__actions">
        {state === "open" && <a class="btn btn--cobalt" href={`/scholarships/${season.slug}/apply`}>Start application <Icon name="arrow" size={18} /></a>}
        {state === "upcoming" && <a class="btn" href={`/scholarships/${season.slug}`}>See details <Icon name="arrow" size={18} /></a>}
        {state === "closed" && <a class="btn" href="#footer-email">Notify me when it opens <Icon name="arrow" size={18} /></a>}
      </div>
    </>
  ) : (
    <>
      <p class="season-card__title">Scholarships <em>every Spring & Fall</em></p>
      <p class="season-card__meta">The next season will be announced soon.</p>
      <div class="season-card__actions"><a class="btn" href="#footer-email">Notify me <Icon name="arrow" size={18} /></a></div>
    </>
  )}
</div>

<style>
  .season-card {
    display: grid; gap: 0.9rem; padding: 1.4rem 1.5rem 1.5rem; border-radius: var(--radius-lg);
    background: var(--white); color: var(--ink); border: 1px solid var(--line);
  }
  .season-card--float { box-shadow: var(--shadow-lg); }
  .season-card__top { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; }
  .season-card__status { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .season-card__days { font-size: 0.8rem; color: var(--text-muted); white-space: nowrap; }
  .season-card__days b { font-family: var(--font-display); font-weight: 400; font-size: 1.35rem; color: var(--ink); }
  .season-card__title { font-family: var(--font-display); font-size: 1.85rem; line-height: 1.02; letter-spacing: -0.01em; }
  .season-card__title em { display: block; color: var(--cobalt); }
  .season-card__meta { font-size: 0.93rem; color: var(--text-muted); }
  .season-card__meta strong { color: var(--ink); font-weight: 600; }
  .season-card__actions .btn { width: 100%; }
</style>
