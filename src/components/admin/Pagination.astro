---
export interface Props {
  page: number;
  pageCount: number;
  total: number;
  baseUrl: string; // includes existing query string minus "page"
}
const { page, pageCount, total, baseUrl } = Astro.props;

function pageHref(p: number) {
  const url = new URL(baseUrl, "https://placeholder.local");
  url.searchParams.set("page", String(p));
  return `${url.pathname}?${url.searchParams.toString()}`;
}
---

<div class="pagination">
  <span>{total} total · page {page} of {pageCount}</span>
  <div class="links">
    {page > 1 && <a class="btn btn-secondary" href={pageHref(page - 1)}>Previous</a>}
    {page < pageCount && <a class="btn btn-secondary" href={pageHref(page + 1)}>Next</a>}
  </div>
</div>
