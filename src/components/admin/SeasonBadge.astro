---
import type { Season } from "../../lib/seasons";
import { seasonState } from "../../lib/seasons";

export interface Props {
  season: Pick<Season, "status" | "opens_at" | "closes_at">;
}
const { season } = Astro.props;

const STATUS_TONE: Record<string, string> = {
  draft: "badge-faint",
  published: "badge-cobalt",
  archived: "badge-neutral",
};
const STATE_TONE: Record<string, string> = {
  upcoming: "badge-warning",
  open: "badge-success",
  closed: "badge-neutral",
};
const state = seasonState(season);
---

<span class={`badge ${STATUS_TONE[season.status] ?? "badge-neutral"}`}>{season.status}</span>
{season.status === "published" && <span class={`badge ${STATE_TONE[state] ?? "badge-neutral"}`}>{state}</span>}
