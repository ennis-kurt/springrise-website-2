---
export interface Props {
  saved?: string | null;
  error?: string | null;
  savedMessage?: string;
}
const { saved, error, savedMessage = "Saved." } = Astro.props;
---

{saved && (
  <div class="notice notice-success" role="status">
    <span>{savedMessage}</span>
    <button type="button" class="btn-ghost" aria-label="Dismiss" onclick="this.closest('.notice').remove()">Dismiss</button>
  </div>
)}

{error && (
  <div class="notice notice-error" role="alert">
    <span>{error}</span>
    <button type="button" class="btn-ghost" aria-label="Dismiss" onclick="this.closest('.notice').remove()">Dismiss</button>
  </div>
)}
