---
// Animated fiscal-year comparison: one metric, two bars, growth badge.
interface Props { label: string; values: number[]; years?: readonly string[]; tone?: "shoot" | "dawn" | "lilac"; night?: boolean }
const { label, values, years = ["FY 2024", "FY 2025"], tone = "shoot", night = true } = Astro.props;
const max = Math.max(...values);
const change = values.length > 1 ? (values[1] - values[0]) / values[0] : 0;
---
<figure class:list={["bars", `bars--${tone}`, !night && "bars--day"]} data-inview>
  <figcaption class="bars__head">
    <span class="bars__label">{label}</span>
    {values.length > 1 && <span class="bars__delta mono">{change >= 0 ? "▲" : "▼"} {(Math.abs(change) * 100).toFixed(1)}%</span>}
  </figcaption>
  {values.map((v, i) => (
    <div class="bars__row">
      <span class="bars__year mono">{years[i]}</span>
      <div class="bars__track"><span class:list={["bars__fill", i === values.length - 1 && "is-now"]} style={`--w:${(v / max) * 100}%; --i:${i}`}></span></div>
      <span class="bars__val mono"><span data-count={Math.round(v)} data-prefix="$">$0</span></span>
    </div>
  ))}
</figure>

<style>
  .bars { margin: 0; display: grid; gap: 0.75rem; }
  .bars__head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 0.3rem; }
  .bars__label { font-weight: 600; }
  .bars__delta { font-size: 0.78rem; padding: 0.25rem 0.55rem; border-radius: var(--r-pill); background: rgb(240 180 76 / 0.14); color: var(--shoot); }
  .bars__row { display: grid; grid-template-columns: 4.6rem 1fr 6.6rem; gap: 0.9rem; align-items: center; }
  .bars__year { font-size: 0.76rem; color: var(--night-muted); }
  .bars__track { height: 0.9rem; border-radius: var(--r-pill); background: var(--night-3); overflow: hidden; }
  .bars__fill { display: block; height: 100%; width: 0; border-radius: inherit; background: rgb(250 244 234 / 0.35); transition: width 1.8s var(--ease); transition-delay: calc(var(--i) * 0.25s + 0.15s); }
  .bars--shoot .is-now { background: linear-gradient(90deg, var(--shoot-deep), var(--shoot)); }
  .bars--dawn .is-now { background: linear-gradient(90deg, var(--dawn-deep), var(--dawn)); }
  .bars--lilac .is-now { background: linear-gradient(90deg, var(--lilac-deep), var(--lilac)); }
  .bars.in .bars__fill { width: var(--w); }
  .bars__val { text-align: right; font-size: 0.9rem; }
  .bars--dawn .bars__delta { background: rgb(208 97 63 / 0.14); color: var(--dawn); }
  .bars--day .bars__track { background: var(--bone-2); }
  .bars--day .bars__year { color: var(--text-muted); }
  .bars--day .bars__fill { background: rgb(43 35 32 / 0.22); }
  .bars--day .bars__delta { background: var(--night); color: var(--shoot); }
  @media (max-width: 520px) { .bars__row { grid-template-columns: 3.8rem 1fr 5.8rem; gap: 0.6rem; } }
</style>
