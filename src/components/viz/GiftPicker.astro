---
// Interactive: choose a gift, see what it makes possible.
import { GIFTS } from "../../lib/facts";
interface Props { night?: boolean }
const { night = false } = Astro.props;
const max = Math.max(...GIFTS.map((g) => g.amount));
---
<div class:list={["gift", night && "gift--night"]} data-gift>
  <div class="gift__tiers" role="radiogroup" aria-label="Choose a gift amount">
    {GIFTS.map((g, i) => (
      <button type="button" role="radio" aria-checked={i === 1 ? "true" : "false"} class="gift__tier" data-i={i}>
        <span class="gift__amt">${g.amount.toLocaleString("en-US")}</span>
        <span class="gift__lab mono">{g.label}</span>
      </button>
    ))}
  </div>
  <div class="gift__out" aria-live="polite">
    <div class="gift__meter" aria-hidden="true">
      <span class="gift__fill" data-fill style={`--w:${(GIFTS[1].amount / max) * 100}%`}></span>
      <span class="gift__ticks">{Array.from({ length: 12 }, () => <i></i>)}</span>
    </div>
    <p class="gift__line" data-line>{GIFTS[1].line}</p>
  </div>
  <script type="application/json" data-gifts set:html={JSON.stringify(GIFTS)}></script>
</div>

<style>
  .gift { display: grid; gap: 1.6rem; }
  .gift__tiers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.6rem; }
  .gift__tier {
    display: grid; gap: 0.35rem; justify-items: start; padding: 1.2rem 1.25rem; border-radius: var(--r); text-align: left;
    border: 1.5px solid var(--line-strong); background: var(--paper); transition: background-color 0.3s, border-color 0.3s, transform 0.4s var(--ease);
  }
  .gift__tier:hover { transform: translateY(-3px); border-color: var(--night); }
  .gift__tier[aria-checked="true"] { background: var(--night); color: var(--bone); border-color: var(--night); }
  .gift__amt { font-family: var(--font-display); font-weight: 750; font-size: clamp(1.5rem, 1.1rem + 1.3vw, 2.3rem); letter-spacing: -0.04em; line-height: 1; }
  .gift__lab { font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.7; }
  .gift__tier[aria-checked="true"] .gift__lab { color: var(--shoot); opacity: 1; }
  .gift__out { display: grid; gap: 1rem; }
  .gift__meter { position: relative; height: 3.2rem; border-radius: var(--r-sm); background: var(--bone-2); overflow: hidden; }
  .gift__fill { position: absolute; inset: 0 auto 0 0; width: var(--w); background: linear-gradient(90deg, var(--shoot-deep), var(--shoot)); border-radius: inherit; transition: width 0.9s var(--ease); }
  .gift__ticks { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(12, 1fr); }
  .gift__ticks i { border-right: 1px solid rgb(16 15 26 / 0.12); }
  .gift__line { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-3); letter-spacing: -0.025em; line-height: 1.15; min-height: 2.3em; }
  .gift--night .gift__tier { background: transparent; border-color: var(--night-line-strong); color: var(--bone); }
  .gift--night .gift__tier[aria-checked="true"] { background: var(--shoot); color: var(--night); border-color: var(--shoot); }
  .gift--night .gift__tier[aria-checked="true"] .gift__lab { color: var(--night); }
  .gift--night .gift__meter { background: var(--night-3); }
  .gift--night .gift__ticks i { border-color: rgb(243 240 232 / 0.08); }
  @media (max-width: 520px) { .gift__tiers { grid-template-columns: 1fr; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-gift]").forEach((root) => {
    const gifts = JSON.parse(root.querySelector("[data-gifts]")!.textContent!) as { amount: number; line: string }[];
    const max = Math.max(...gifts.map((g) => g.amount));
    const tiers = [...root.querySelectorAll<HTMLButtonElement>(".gift__tier")];
    const fill = root.querySelector<HTMLElement>("[data-fill]")!;
    const line = root.querySelector<HTMLElement>("[data-line]")!;
    const pick = (i: number, focus = false) => {
      tiers.forEach((t, j) => { t.setAttribute("aria-checked", String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      fill.style.setProperty("--w", `${(gifts[i].amount / max) * 100}%`);
      line.textContent = gifts[i].line;
      if (focus) tiers[i].focus();
    };
    tiers.forEach((t, i) => {
      t.addEventListener("click", () => pick(i));
      t.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight" || e.key === "ArrowDown") { e.preventDefault(); pick((i + 1) % tiers.length, true); }
        if (e.key === "ArrowLeft" || e.key === "ArrowUp") { e.preventDefault(); pick((i - 1 + tiers.length) % tiers.length, true); }
      });
    });
    pick(1);
  });
</script>
