---
// Animated ring: share of spending that goes directly to students.
import { FINANCE } from "../../lib/facts";
interface Props { size?: number }
const { size = 340 } = Astro.props;
const aid = FINANCE.scholarships[1];
const ops = FINANCE.operations[1];
const share = aid / (aid + ops); // 0.9706…
const r = 44, c = 2 * Math.PI * r;
---
<figure class="ring" data-inview style={`--size:${size}px; --c:${c}; --share:${share}`}>
  <svg viewBox="0 0 100 100" role="img" aria-label={`${(share * 100).toFixed(1)}% of FY 2025 spending went directly to student scholarships; ${(100 - share * 100).toFixed(1)}% to operations and legal.`}>
    <circle class="ring__track" cx="50" cy="50" r={r} />
    <circle class="ring__ops" cx="50" cy="50" r={r} />
    <circle class="ring__aid" cx="50" cy="50" r={r} />
  </svg>
  <div class="ring__center">
    <span class="ring__num"><span data-count={(share * 100).toFixed(1)} data-decimals="1">0</span><small>%</small></span>
    <span class="ring__cap">direct to students</span>
  </div>
</figure>

<style>
  .ring { position: relative; width: min(100%, var(--size)); aspect-ratio: 1; margin: 0; }
  .ring svg { width: 100%; height: 100%; transform: rotate(-90deg); overflow: visible; }
  .ring circle { fill: none; stroke-width: 9; }
  .ring__track { stroke: var(--night-line); }
  .ring__aid { stroke: var(--shoot); stroke-linecap: round; stroke-dasharray: var(--c); stroke-dashoffset: var(--c); transition: stroke-dashoffset 2.2s var(--ease) 0.2s;  }
  .ring__ops { stroke: var(--lilac); stroke-dasharray: calc(var(--c) * (1 - var(--share)) - 2) var(--c); stroke-dashoffset: calc(var(--c) * -1 * var(--share) - 1); opacity: 0; transition: opacity 0.6s 2.1s; }
  .ring.in .ring__aid { stroke-dashoffset: calc(var(--c) * (1 - var(--share) + 0.004)); }
  .ring.in .ring__ops { opacity: 1; }
  .ring__center { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }
  .ring__num { font-family: var(--font-display); font-weight: 560; font-size: calc(var(--size) * 0.23); letter-spacing: -0.015em; line-height: 0.9; }
  .ring__num small { font-size: 0.45em; margin-left: 0.04em; }
  .ring__cap { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--night-muted); margin-top: 0.6rem; }
  @media (max-width: 480px) { .ring__num { font-size: 4.2rem; } }
</style>
