---
// Line glyphs for the three pillars. They warm up gently when the card is hovered or focused.
interface Props { kind: "scholarships" | "internships" | "mentorship" }
const { kind } = Astro.props;
---
<svg class:list={["glyph", `glyph--${kind}`]} viewBox="0 0 160 110" aria-hidden="true">
  {kind === "scholarships" && (
    <g>
      <path class="g-base" d="M10 100h140" />
      <path class="g-l" pathLength="1" d="M30 100V70" /><path class="g-l" pathLength="1" style="--o:.1s" d="M58 100V56" />
      <path class="g-l" pathLength="1" style="--o:.2s" d="M86 100V40" /><path class="g-l g-hi" pathLength="1" style="--o:.3s" d="M114 100V22" />
      <circle class="g-dot" cx="114" cy="16" r="6" />
      <path class="g-l g-soft" pathLength="1" style="--o:.4s" d="M22 78 60 60l28-14 30-26" />
    </g>
  )}
  {kind === "internships" && (
    <g>
      <path class="g-base" d="M10 100h140" />
      <path class="g-l" pathLength="1" d="M52 100V18h56v82" />
      <path class="g-l g-hi g-door" pathLength="1" style="--o:.15s" d="M52 18l34 10v80l-34-8" />
      <circle class="g-dot" cx="78" cy="64" r="4" />
      <path class="g-l g-soft" pathLength="1" style="--o:.35s" d="M118 58h26m-8-8 8 8-8 8" />
    </g>
  )}
  {kind === "mentorship" && (
    <g>
      <path class="g-base" d="M10 100h140" />
      <path class="g-l" pathLength="1" d="M18 96C50 96 58 60 84 54" />
      <path class="g-l g-hi" pathLength="1" style="--o:.15s" d="M40 100c26-6 34-40 44-46 12-8 26-12 42-34" />
      <circle class="g-dot" cx="126" cy="20" r="6" />
      <circle class="g-dot g-dot--2" cx="84" cy="54" r="4.5" />
    </g>
  )}
</svg>

<style>
  .glyph { width: min(100%, 13rem); height: auto; overflow: visible; }
  .glyph path, .glyph circle { fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .g-base { opacity: 0.22; }
  .g-soft { opacity: 0.45; stroke-dasharray: 0.02 0.04; }
  .g-l { stroke-dasharray: 1; stroke-dashoffset: 0; transition: stroke-dashoffset 1.1s var(--ease) var(--o, 0s), stroke 0.9s var(--ease); }
  .g-dot { fill: currentColor !important; stroke: none !important; transition: transform 1.1s var(--ease), fill 0.9s var(--ease); transform-box: fill-box; transform-origin: center; }
  :global(.pillar:hover) .g-hi, :global(.pillar:focus-visible) .g-hi { stroke: var(--shoot-deep); }
  :global(.pillar:hover) .g-dot, :global(.pillar:focus-visible) .g-dot { fill: var(--shoot) !important; transform: translateY(-4px) scale(1.15); }
  :global(.pillar:hover) .g-dot--2 { fill: var(--dawn) !important; }
  :global(.pillar:hover) .g-door { transform: none; }
</style>
