---
// Editorial header for interior pages.
// Usage: <PageHero eyebrow="About us" title="Rooted in community," accent="rising together." lead="…" />
import TilePattern from "./TilePattern.astro";
import Mark from "./Mark.astro";
interface Props {
  eyebrow: string;
  title: string;
  /** Italic continuation of the title, rendered on a new line in the accent colour */
  accent?: string;
  lead?: string;
  /** "arch" shows a decorative arched tile window on the right; "none" hides it */
  art?: "arch" | "none";
  tone?: "paper" | "ink";
}
const { eyebrow, title, accent, lead, art = "arch", tone = "paper" } = Astro.props;
---
<section class:list={["page-hero", `page-hero--${tone}`, art === "none" && "page-hero--plain"]}>
  <div class="container page-hero__grid">
    <div class="page-hero__text">
      <p class="eyebrow reveal">{eyebrow}</p>
      <h1 class="display reveal" style="--d:.08s">
        {title}{accent && <><br /><em>{accent}</em></>}
      </h1>
      {lead && <p class="lead reveal" style="--d:.16s">{lead}</p>}
      <div class="page-hero__slot reveal" style="--d:.24s"><slot /></div>
    </div>
    {art === "arch" && (
      <div class="page-hero__art reveal" style="--d:.2s" aria-hidden="true">
        <div class="arch">
          <TilePattern id={`hero-tile-${eyebrow.replace(/\W+/g, "")}`} color="var(--paper)" opacity={0.35} scale={0.9} />
          <div class="arch__sun"></div>
          <Mark size={190} tone="light" bare class="arch__mark" />
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .page-hero { position: relative; padding-top: clamp(3rem, 6vw, 6rem); padding-bottom: clamp(3.5rem, 7vw, 7rem); }
  .page-hero--ink { background: var(--ink); color: var(--paper); margin-top: -5.25rem; padding-top: calc(5.25rem + clamp(3rem, 6vw, 6rem)); }
  .page-hero--ink .lead, .page-hero--ink .eyebrow { color: rgb(247 242 233 / 0.72); }
  .page-hero__grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 6rem); align-items: end; }
  .page-hero--plain .page-hero__grid { grid-template-columns: 1fr; }
  .page-hero__text h1 { margin-top: 1.4rem; }
  .page-hero__text h1 em { color: var(--cobalt); }
  .page-hero--ink .page-hero__text h1 em { color: var(--saffron); }
  .page-hero__text .lead { margin-top: 1.6rem; }
  .page-hero__slot:empty { display: none; }
  .page-hero__slot { margin-top: 2rem; }
  .page-hero__art { justify-self: end; width: min(100%, 22rem); }
  .arch {
    position: relative; aspect-ratio: 3 / 4; border-radius: var(--arch); overflow: hidden;
    background: linear-gradient(180deg, var(--cobalt) 0%, var(--cobalt-deep) 60%, var(--ink) 100%);
    color: var(--paper); box-shadow: var(--shadow-lg);
  }
  .arch__sun {
    position: absolute; left: 50%; bottom: -22%; width: 78%; aspect-ratio: 1; border-radius: 50%;
    transform: translateX(-50%); background: radial-gradient(circle at 50% 40%, var(--saffron), var(--tulip) 70%);
    animation: sunrise 2.4s var(--ease) both 0.3s;
  }
  .arch :global(.arch__mark) { position: absolute; left: 50%; bottom: 4%; transform: translateX(-50%); color: var(--paper); filter: drop-shadow(0 12px 24px rgb(13 23 51 / 0.35)); }
  @keyframes sunrise { from { transform: translate(-50%, 35%); opacity: 0; } to { transform: translate(-50%, 0); opacity: 1; } }
  @media (max-width: 820px) {
    .page-hero__grid { grid-template-columns: 1fr; }
    .page-hero__art { display: none; }
  }
</style>
