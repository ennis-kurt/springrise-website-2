---
// İznik-inspired repeating tile: tulips on a diagonal lattice with small eight-point stars.
interface Props { id?: string; color?: string; opacity?: number; scale?: number; class?: string }
const { id = "tile", color = "currentColor", opacity = 1, scale = 1, class: cls = "" } = Astro.props;
const s = 72 * scale;
---
<svg class:list={["tile-pattern", cls]} aria-hidden="true" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <pattern id={id} width={s} height={s} patternUnits="userSpaceOnUse" patternTransform={`scale(${scale})`}>
      <g fill="none" stroke={color} stroke-width="1" opacity={opacity}>
        <!-- lattice -->
        <path d="M0 36 36 0 72 36 36 72Z" />
        <!-- tulip at centre -->
        <path d="M36 48c-5.2-.4-9-4.6-9.3-15.6 3.1 2.7 6.6 6.9 9.3 15.6Zm0 0c5.2-.4 9-4.6 9.3-15.6-3.1 2.7-6.6 6.9-9.3 15.6Zm0-26c3.4 4.6 4.8 9.3 4.1 13.6-.5 3.2-2 5.2-4.1 6.6-2.1-1.4-3.6-3.4-4.1-6.6-.7-4.3.7-9 4.1-13.6Z" />
        <!-- stars at lattice corners -->
        <path d="M0 -5 1.5 -1.5 5 0 1.5 1.5 0 5 -1.5 1.5 -5 0 -1.5 -1.5Z" transform="translate(0 0)" />
        <path d="M0 -5 1.5 -1.5 5 0 1.5 1.5 0 5 -1.5 1.5 -5 0 -1.5 -1.5Z" transform="translate(72 0)" />
        <path d="M0 -5 1.5 -1.5 5 0 1.5 1.5 0 5 -1.5 1.5 -5 0 -1.5 -1.5Z" transform="translate(0 72)" />
        <path d="M0 -5 1.5 -1.5 5 0 1.5 1.5 0 5 -1.5 1.5 -5 0 -1.5 -1.5Z" transform="translate(72 72)" />
      </g>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>

<style>
  .tile-pattern { position: absolute; inset: 0; pointer-events: none; }
</style>
