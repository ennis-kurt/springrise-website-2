---
import BaseLayout from "../layouts/BaseLayout.astro";
import Mark from "../components/Mark.astro";
import TilePattern from "../components/TilePattern.astro";
import Icon from "../components/Icon.astro";
---
<BaseLayout title="Page not found" description="This page has moved on." noindex>
  <section class="not-found">
    <TilePattern id="404-tile" color="var(--ink)" opacity={0.05} scale={1.3} />
    <div class="container not-found__inner">
      <Mark size={72} tone="color" class="not-found__mark reveal" />
      <h1 class="mega reveal" style="--d:.08s"><span class="visually-hidden">Page not found — </span>404</h1>
      <p class="lead not-found__copy reveal" style="--d:.16s">This page has moved on — like every good student.</p>
      <div class="not-found__actions reveal" style="--d:.24s">
        <a class="btn btn--cobalt btn--lg" href="/">Go home <Icon name="arrow" size={18} /></a>
        <a class="btn btn--ghost btn--lg" href="/scholarships">See scholarships</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { position: relative; overflow: hidden; padding-block: clamp(5rem, 14vw, 9rem); text-align: center; }
  .not-found__inner { position: relative; display: flex; flex-direction: column; align-items: center; }
  .not-found__mark { margin-bottom: 1.5rem; }
  .not-found .mega { color: var(--cobalt); }
  .not-found__copy { margin-top: 1.25rem; max-width: 28rem; margin-inline: auto; }
  .not-found__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.85rem; margin-top: 2.5rem; }
</style>
