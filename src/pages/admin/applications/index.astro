---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import StatusBadge from "../../../components/admin/StatusBadge.astro";
import Pagination from "../../../components/admin/Pagination.astro";
import { listApplications, listSeasonsWithCounts } from "../../../lib/server/db";
import { fmtDateTime, STATUS_LABELS } from "../../../lib/seasons";

const url = Astro.url;
const seasonId = url.searchParams.get("season") || "";
const status = url.searchParams.get("status") || "";
const search = url.searchParams.get("q") || "";
const page = Number(url.searchParams.get("page") || "1") || 1;

const [seasons, result] = await Promise.all([
  listSeasonsWithCounts(env.DB),
  listApplications(env.DB, { seasonId: seasonId || undefined, status: status || undefined, search: search || undefined, page }),
]);

const exportParams = new URLSearchParams();
if (seasonId) exportParams.set("season", seasonId);
const exportHref = `/api/admin/export/applications.csv${exportParams.toString() ? `?${exportParams}` : ""}`;

const baseParams = new URLSearchParams();
if (seasonId) baseParams.set("season", seasonId);
if (status) baseParams.set("status", status);
if (search) baseParams.set("q", search);
const baseUrl = `/admin/applications?${baseParams.toString()}`;
---

<AdminLayout title="Applications" active="applications">
  <div class="section-heading" style="margin-top:0;">
    <div>
      <h1 class="page-title">Applications</h1>
      <p class="page-subtitle">All scholarship applications across every season.</p>
    </div>
    <a class="btn btn-secondary" href={exportHref}>Export CSV</a>
  </div>

  <form class="filters" method="GET" action="/admin/applications">
    <div class="field">
      <label for="season">Season</label>
      <select id="season" name="season">
        <option value="">All seasons</option>
        {seasons.map((s) => (
          <option value={s.id} selected={s.id === seasonId}>{s.title} ({s.application_count})</option>
        ))}
      </select>
    </div>
    <div class="field">
      <label for="status">Status</label>
      <select id="status" name="status">
        <option value="">All statuses</option>
        {Object.entries(STATUS_LABELS).map(([key, label]) => (
          <option value={key} selected={key === status}>{label}</option>
        ))}
      </select>
    </div>
    <div class="field" style="flex:1;">
      <label for="q">Search</label>
      <input id="q" name="q" type="search" placeholder="Name, email or reference" value={search} />
    </div>
    <div class="field" style="margin-bottom:0;">
      <button class="btn btn-primary" type="submit">Filter</button>
    </div>
  </form>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Reference</th>
          <th>Applicant</th>
          <th>Email</th>
          <th>Status</th>
          <th>Tuition</th>
          <th>Submitted</th>
        </tr>
      </thead>
      <tbody>
        {result.rows.length === 0 && <tr><td colspan="6" class="table-empty">No applications match these filters.</td></tr>}
        {result.rows.map((app) => (
          <tr>
            <td><a class="link-quiet" href={`/admin/applications/${app.id}`}>{app.reference}</a></td>
            <td>{app.first_name} {app.last_name}</td>
            <td>{app.email}</td>
            <td><StatusBadge status={app.status} /></td>
            <td>{(app.tuition_cents / 100).toLocaleString("en-US", { style: "currency", currency: "USD" })}</td>
            <td>{fmtDateTime(app.created_at)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <Pagination page={result.page} pageCount={result.pageCount} total={result.total} baseUrl={baseUrl} />
</AdminLayout>
