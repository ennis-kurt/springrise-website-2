---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Notice from "../../../components/admin/Notice.astro";
import StatusBadge from "../../../components/admin/StatusBadge.astro";
import { getApplicationDetail, getSeason } from "../../../lib/server/db";
import { emailEnabled } from "../../../lib/server/email";
import { fmtDateTime, STATUS_LABELS } from "../../../lib/seasons";
import { DOCUMENTS } from "../../../lib/content";

const emailOn = emailEnabled();
const id = Astro.params.id!;
const app = await getApplicationDetail(env.DB, id);
if (!app) return new Response(null, { status: 404 });

const season = await getSeason(env.DB, app.seasonId);
const saved = Astro.url.searchParams.get("saved");
const error = Astro.url.searchParams.get("error");

const docsByKind = new Map(app.documents.map((d) => [d.kind, d]));

const mailSubject = encodeURIComponent(`Springrise scholarship application ${app.reference}`);
const mailtoHref = `mailto:${app.email}?subject=${mailSubject}`;

function fmtBytes(n: number) {
  return n < 1024 * 1024 ? `${Math.round(n / 1024)} KB` : `${(n / (1024 * 1024)).toFixed(1)} MB`;
}
---

<AdminLayout title={app.reference} active="applications">
  <div class="section-heading" style="margin-top:0;">
    <div>
      <p class="label" style="margin-bottom:0.35rem;">{season?.title ?? app.seasonId}</p>
      <h1 class="page-title">{app.firstName} {app.lastName}</h1>
      <p class="page-subtitle">{app.reference} · <StatusBadge status={app.status} /></p>
    </div>
    <a class="btn btn-secondary" href={mailtoHref}>Email applicant</a>
  </div>

  <Notice saved={saved} error={error} savedMessage="Application updated." />

  <div class="grid cols-2">
    <div class="card">
      <p class="label">Applicant</p>
      <dl class="kv">
        <dt>Name</dt><dd>{app.firstName} {app.lastName}</dd>
        <dt>Email</dt><dd>{app.email}</dd>
        <dt>Phone</dt><dd>{app.phone}</dd>
        <dt>Birthday</dt><dd>{app.data.birthday}</dd>
        <dt>Address</dt>
        <dd>
          {app.data.address}{app.data.address2 ? `, ${app.data.address2}` : ""}<br />
          {app.data.city}{app.data.region ? `, ${app.data.region}` : ""} {app.data.postalCode}<br />
          {app.data.country}
        </dd>
      </dl>
    </div>

    <div class="card">
      <p class="label">Education & tuition</p>
      <dl class="kv">
        <dt>Institution</dt><dd>{app.institution}</dd>
        <dt>Study level</dt><dd>{app.data.studyLevel}</dd>
        <dt>Major</dt><dd>{app.data.major || "—"}</dd>
        <dt>Tuition requested</dt><dd>{(app.tuitionCents / 100).toLocaleString("en-US", { style: "currency", currency: "USD" })}</dd>
        <dt>Tuition deadline</dt><dd>{app.data.tuitionDeadline}</dd>
      </dl>
    </div>

    <div class="card">
      <p class="label">Reference 1</p>
      <dl class="kv">
        <dt>Name</dt><dd>{app.data.reference1Name}</dd>
        <dt>Email</dt><dd>{app.data.reference1Email}</dd>
        <dt>Phone</dt><dd>{app.data.reference1Phone}</dd>
        <dt>Relationship</dt><dd>{app.data.reference1Relationship || "—"}</dd>
      </dl>
    </div>

    <div class="card">
      <p class="label">Reference 2</p>
      <dl class="kv">
        <dt>Name</dt><dd>{app.data.reference2Name}</dd>
        <dt>Email</dt><dd>{app.data.reference2Email}</dd>
        <dt>Phone</dt><dd>{app.data.reference2Phone}</dd>
        <dt>Relationship</dt><dd>{app.data.reference2Relationship || "—"}</dd>
      </dl>
    </div>
  </div>

  {app.data.note && (
    <div class="card">
      <p class="label">Applicant note</p>
      <p style="white-space:pre-wrap; margin:0;">{app.data.note}</p>
    </div>
  )}

  <div class="card">
    <p class="label">Documents</p>
    <ul class="doc-list">
      {DOCUMENTS.map((doc) => {
        const file = docsByKind.get(doc.key);
        return (
          <li>
            <span>{doc.label}{!doc.required && " (optional)"}</span>
            {file ? (
              <a class="btn btn-secondary" href={`/api/admin/documents/${file.id}`} target="_blank" rel="noopener">
                Open ({fmtBytes(file.size)})
              </a>
            ) : (
              <span class="badge badge-faint">Not provided</span>
            )}
          </li>
        );
      })}
    </ul>
  </div>

  <div class="card">
    <p class="label">Update status</p>
    <form method="POST" action={`/api/admin/applications/${app.id}`}>
      <div class="field-row">
        <div class="field">
          <label for="status">Status</label>
          <select id="status" name="status" required>
            {Object.entries(STATUS_LABELS).map(([key, label]) => (
              <option value={key} selected={key === app.status}>{label}</option>
            ))}
          </select>
        </div>
        <div class="field">
          <label for="awardAmount">Award amount ($)</label>
          <input
            id="awardAmount"
            name="awardAmount"
            inputmode="decimal"
            placeholder="0.00"
            value={app.awardCents != null ? (app.awardCents / 100).toFixed(2) : ""}
          />
        </div>
      </div>
      <div class="field">
        <label for="staffNotes">Staff notes</label>
        <textarea id="staffNotes" name="staffNotes" rows="4" maxlength="4000">{app.staffNotes}</textarea>
      </div>
      <div class="field">
        <label for="notifyApplicant" style="text-transform:none; font-family:var(--font-sans); font-size:0.95rem; letter-spacing:normal; display:flex; align-items:center; gap:0.5rem;">
          <input id="notifyApplicant" name="notifyApplicant" type="checkbox" style="width:auto;" disabled={!emailOn} />
          Email the applicant about this update
        </label>
        {!emailOn && <p class="hint">Email sending isn't configured (RESEND_API_KEY).</p>}
      </div>
      <div class="field">
        <label for="applicantMessage">Message to applicant (optional)</label>
        <textarea id="applicantMessage" name="applicantMessage" rows="3" maxlength="2000" placeholder="A short note included in the email." disabled={!emailOn}></textarea>
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Save</button>
      </div>
    </form>
  </div>

  <div class="card">
    <p class="label">Timeline</p>
    <ul class="timeline">
      {app.events.map((event) => (
        <li>
          <time datetime={event.created_at}>{fmtDateTime(event.created_at)}</time>
          <span><strong>{event.kind}</strong> — {event.detail}</span>
        </li>
      ))}
    </ul>
  </div>
</AdminLayout>
