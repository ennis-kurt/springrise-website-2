---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Notice from "../../../components/admin/Notice.astro";
import { listMessages } from "../../../lib/server/db";
import { fmtDateTime } from "../../../lib/seasons";

const status = Astro.url.searchParams.get("status") || "";
const saved = Astro.url.searchParams.get("saved");
const error = Astro.url.searchParams.get("error");

const messages = await listMessages(env.DB, status || undefined);

const STATUS_TONE: Record<string, string> = { new: "badge-cobalt", read: "badge-neutral", archived: "badge-faint" };
---

<AdminLayout title="Messages" active="messages">
  <div class="section-heading" style="margin-top:0;">
    <div>
      <h1 class="page-title">Messages</h1>
      <p class="page-subtitle">Contact form submissions from the public site.</p>
    </div>
    <a class="btn btn-secondary" href="/api/admin/export/messages.csv">Export CSV</a>
  </div>

  <Notice saved={saved} error={error} savedMessage="Message updated." />

  <form class="filters" method="GET" action="/admin/messages">
    <div class="field">
      <label for="status">Status</label>
      <select id="status" name="status">
        <option value="">All</option>
        <option value="new" selected={status === "new"}>New</option>
        <option value="read" selected={status === "read"}>Read</option>
        <option value="archived" selected={status === "archived"}>Archived</option>
      </select>
    </div>
    <div class="field" style="margin-bottom:0;">
      <button class="btn btn-primary" type="submit">Filter</button>
    </div>
  </form>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>From</th>
          <th>Topic</th>
          <th>Message</th>
          <th>Received</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {messages.length === 0 && <tr><td colspan="6" class="table-empty">No messages.</td></tr>}
        {messages.map((m) => (
          <tr>
            <td>
              <strong>{m.name}</strong><br />
              <a class="link-quiet" href={`mailto:${m.email}${m.subject ? `?subject=${encodeURIComponent(`Re: ${m.subject}`)}` : ""}`}>{m.email}</a>
            </td>
            <td>{m.topic}</td>
            <td style="max-width:26rem; white-space:pre-wrap;">{m.subject && <strong>{m.subject}</strong>}<br />{m.message}</td>
            <td>{fmtDateTime(m.created_at)}</td>
            <td><span class={`badge ${STATUS_TONE[m.status] ?? "badge-neutral"}`}>{m.status}</span></td>
            <td>
              <form method="POST" action={`/api/admin/messages/${m.id}`} style="display:flex; gap:0.4rem;">
                <select name="status" aria-label="Change status">
                  <option value="new" selected={m.status === "new"}>New</option>
                  <option value="read" selected={m.status === "read"}>Read</option>
                  <option value="archived" selected={m.status === "archived"}>Archived</option>
                </select>
                <button class="btn btn-secondary" type="submit">Save</button>
              </form>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
