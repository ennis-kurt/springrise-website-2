---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Notice from "../../../components/admin/Notice.astro";
import SeasonForm from "../../../components/admin/SeasonForm.astro";
import { ApiError } from "../../../lib/server/http";
import {
  countSubscribers,
  getSeason,
  getSeasonAnnouncementInfo,
  seasonHasApplications,
  seasonSlugExists,
  updateSeason,
} from "../../../lib/server/db";
import { rawSeasonFormValues, seasonInputFromForm, type SeasonFormValues } from "../../../lib/server/season-input";
import { emailEnabled } from "../../../lib/server/email";
import { fmtDateTime, seasonState } from "../../../lib/seasons";

const id = Astro.params.id!;
const season = await getSeason(env.DB, id);

if (!season) {
  return new Response(null, { status: 404 });
}

const hasApplications = await seasonHasApplications(env.DB, id);
let saved = Astro.url.searchParams.get("saved");
let error = Astro.url.searchParams.get("error");
const announced = Astro.url.searchParams.get("announced");
let values: SeasonFormValues | undefined;

// See src/pages/admin/seasons/new.astro for why this posts to itself instead
// of the /api/admin/seasons/[id] endpoint (which still works on its own).
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  values = rawSeasonFormValues(form);
  try {
    const input = seasonInputFromForm(form);
    if (input.slug !== season.slug) {
      if (hasApplications) throw new ApiError(400, "The slug can't be changed once a season has applications.", "slug");
      if (await seasonSlugExists(env.DB, input.slug, id)) throw new ApiError(409, "A season with this slug already exists.", "slug");
    }
    await updateSeason(env.DB, id, input);
    return Astro.redirect(`/admin/seasons/${id}?saved=1`, 303);
  } catch (err) {
    error = err instanceof ApiError ? err.message : "Something went wrong. Please try again.";
    if (!(err instanceof ApiError)) console.error("update season error", err);
  }
}

const state = seasonState(season);
const canAnnounce = season.status === "published" && (state === "upcoming" || state === "open");
const [subscriberCount, announceInfo] = canAnnounce
  ? await Promise.all([countSubscribers(env.DB), getSeasonAnnouncementInfo(env.DB, id)])
  : [0, null];
const emailOn = emailEnabled();
---

<AdminLayout title={season.title} active="seasons">
  <div class="section-heading" style="margin-top:0;">
    <div>
      <h1 class="page-title">{season.title}</h1>
      <p class="page-subtitle">Editing this season's dates, status and public copy. Times are shown in Eastern (America/New_York).</p>
    </div>
    <a class="btn btn-secondary" href={`/scholarships`} target="_blank" rel="noopener">View public page ↗</a>
  </div>

  <Notice saved={saved} error={error} savedMessage="Season saved." />

  <div class="card">
    <SeasonForm action={`/admin/seasons/${season.id}`} season={season} slugLocked={hasApplications} values={values} />
  </div>

  {canAnnounce && (
    <div class="card">
      <p class="label">Email subscribers</p>
      <p style="color:var(--text-muted); margin-top:0;">
        {subscriberCount} subscriber{subscriberCount === 1 ? "" : "s"}.{" "}
        {announceInfo?.announced_at
          ? `Last announced ${fmtDateTime(announceInfo.announced_at)} to ${announceInfo.announced_count} recipient${announceInfo.announced_count === 1 ? "" : "s"}.`
          : "Not announced yet."}
      </p>
      {announced && (
        <div class="notice notice-success" role="status">
          <span>Sent to {announced} subscriber{announced === "1" ? "" : "s"}.</span>
        </div>
      )}
      {!emailOn && <p class="hint">Email sending isn't configured (RESEND_API_KEY).</p>}
      <form method="POST" action={`/api/admin/seasons/${season.id}/announce`}>
        {announceInfo?.announced_at && <input type="hidden" name="force" value="1" />}
        <button
          class="btn btn-secondary"
          type="submit"
          disabled={!emailOn || subscriberCount === 0}
          onclick={`return confirm(${JSON.stringify(`Email ${subscriberCount} subscriber${subscriberCount === 1 ? "" : "s"} about ${season.title}?`)})`}
        >
          {announceInfo?.announced_at ? "Send announcement again" : "Email subscribers"}
        </button>
      </form>
    </div>
  )}
</AdminLayout>
