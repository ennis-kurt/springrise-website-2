---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Notice from "../../../components/admin/Notice.astro";
import SeasonForm from "../../../components/admin/SeasonForm.astro";
import { ApiError } from "../../../lib/server/http";
import { createSeason, seasonSlugExists } from "../../../lib/server/db";
import { rawSeasonFormValues, seasonInputFromForm, type SeasonFormValues } from "../../../lib/server/season-input";

let error = Astro.url.searchParams.get("error");
let values: SeasonFormValues | undefined;

// The form posts to this same page (rather than the JSON-ish /api/admin/seasons
// endpoint) so a validation error can re-render with everything the user typed,
// instead of losing it across a redirect. The API endpoint still works on its
// own for any other caller.
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  values = rawSeasonFormValues(form);
  try {
    const input = seasonInputFromForm(form);
    if (await seasonSlugExists(env.DB, input.slug)) throw new ApiError(409, "A season with this slug already exists.", "slug");
    const id = input.slug;
    await createSeason(env.DB, id, input);
    return Astro.redirect(`/admin/seasons/${id}?saved=1`, 303);
  } catch (err) {
    error = err instanceof ApiError ? err.message : "Something went wrong. Please try again.";
    if (!(err instanceof ApiError)) console.error("create season error", err);
  }
}
---

<AdminLayout title="New season" active="seasons">
  <h1 class="page-title">New season</h1>
  <p class="page-subtitle">Set up a new scholarship season. It starts as a draft and is never shown publicly until you set its status to Published.</p>

  <Notice error={error} />

  <div class="card">
    <SeasonForm action="/admin/seasons/new" values={values} />
  </div>
</AdminLayout>
