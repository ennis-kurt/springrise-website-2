---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { listSubscribers } from "../../../lib/server/db";
import { fmtDateTime } from "../../../lib/seasons";

const subscribers = await listSubscribers(env.DB);
---

<AdminLayout title="Subscribers" active="subscribers">
  <div class="section-heading" style="margin-top:0;">
    <div>
      <h1 class="page-title">Subscribers</h1>
      <p class="page-subtitle">Everyone who asked to hear about new seasons.</p>
    </div>
    <a class="btn btn-secondary" href="/api/admin/export/subscribers.csv">Export CSV</a>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Email</th>
          <th>Source</th>
          <th>Subscribed</th>
        </tr>
      </thead>
      <tbody>
        {subscribers.length === 0 && <tr><td colspan="3" class="table-empty">No subscribers yet.</td></tr>}
        {subscribers.map((s) => (
          <tr>
            <td>{s.email}</td>
            <td>{s.source}</td>
            <td>{fmtDateTime(s.created_at)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
