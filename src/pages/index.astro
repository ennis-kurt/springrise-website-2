---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import Mark from "../components/Mark.astro";
import TilePattern from "../components/TilePattern.astro";
import SeasonCard from "../components/SeasonCard.astro";
import { getSiteState } from "../lib/site";
import { ORG, PROGRAMS } from "../lib/content";
import { fmtDate } from "../lib/seasons";

const site = await getSiteState();
const { current, seasons } = site;
const history = [...seasons].filter((s) => s.status !== "draft").reverse(); // oldest → newest
const hasNext = seasons.some((s) => s.state !== "closed");

const marquee = current?.state === "open"
  ? [`${current.term} ${current.year} applications are open`, `Apply by ${fmtDate(current.closes_at)}`, "Tuition paid directly to your school", "Students of Turkish descent in U.S. higher education"]
  : current?.state === "upcoming"
    ? [`${current.term} ${current.year} applications open ${fmtDate(current.opens_at)}`, "Get your documents ready", "Tuition paid directly to your school", "Two seasons every year"]
    : ["Scholarships every Spring & Fall", "Tuition paid directly to your school", "Mentorship beyond the classroom", "A community that believes in you"];

const steps = [
  { n: "01", t: "Announce", b: "Each Spring and Fall we open a new scholarship season. Join the list and we'll let you know when it opens." },
  { n: "02", t: "Apply", b: "One guided online application: your details, tuition and two references, and five PDF documents." },
  { n: "03", t: "Review", b: "The Board of Directors reviews every application holistically — academics, need, resilience, leadership and service." },
  { n: "04", t: "Award", b: "Awards are paid directly to your college or university as tuition, one semester at a time." },
];

const facts = [
  { big: "3.0", small: "minimum GPA", note: "for current college students" },
  { big: "3.5", small: "high-school GPA", note: "plus a 1350 SAT, for incoming first-years" },
  { big: "300+", small: "word personal statement", note: "your goals, need and challenges" },
  { big: "2", small: "references", note: "people who know you — not relatives" },
  { big: "1", small: "semester per application", note: "apply again each season you need" },
  { big: "100%", small: "paid to your school", note: "tuition only, never cash to students" },
];

const programIcons = ["school", "people", "handshake", "megaphone"] as const;
const programLinks = ["/scholarships", "/about#mentorship", "/about#partnerships", "/about#advocacy"];
---
<BaseLayout site={site}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="eyebrow hero__eyebrow">Scholarships · Mentorship · Community</p>
        <h1 class="mega hero__title">
          <span class="line"><span>Where</span></span>
          <span class="line"><span>potential</span></span>
          <span class="line"><span><em>rises.</em></span></span>
        </h1>
        <p class="lead hero__lead">
          Springrise Foundation helps students of Turkish descent across the United States stay in school and
          thrive — with seasonal tuition scholarships paid straight to their college, mentorship, and a community
          that believes in them.
        </p>
        <div class="hero__actions">
          {current?.state === "open" ? (
            <a class="btn btn--cobalt btn--lg" href={`/scholarships/${current.slug}/apply`}>Apply for {current.term} {current.year} <Icon name="arrow" size={18} /></a>
          ) : (
            <a class="btn btn--cobalt btn--lg" href="/scholarships">Explore scholarships <Icon name="arrow" size={18} /></a>
          )}
          <a class="btn btn--ghost btn--lg" href="/donate"><Icon name="heart" size={18} /> Fund a semester</a>
        </div>
      </div>

      <div class="hero__art" aria-hidden="false">
        <div class="hero__sun" aria-hidden="true"></div>
        <figure class="hero__photo frame-arch">
          <img class="photo" src="/images/students-1100.webp" srcset="/images/students-640.webp 640w, /images/students-1100.webp 1100w" sizes="(max-width: 960px) 80vw, 30vw" alt="Students studying together at an outdoor table on campus" width="1100" height="733" fetchpriority="high" />
        </figure>
        <div class="hero__tile" aria-hidden="true">
          <TilePattern id="hero-tile" color="var(--paper)" opacity={0.3} scale={0.7} />
          <Mark size={120} tone="light" bare class="hero__tulip" />
        </div>
        <svg class="hero__badge" viewBox="0 0 200 200" aria-hidden="true">
          <defs><path id="badge-circle" d="M100 100m-78 0a78 78 0 1 1 156 0a78 78 0 1 1-156 0" /></defs>
          <text><textPath href="#badge-circle" textLength="486" lengthAdjust="spacing">Spring · Fall · Tuition scholarships · Since 2024 ·</textPath></text>
        </svg>
        <div class="hero__card">
          <SeasonCard season={current} hasNext={hasNext} />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MARQUEE ============ -->
  <section class="ticker" aria-label="Scholarship news">
    <div class="marquee">
      {[0, 1].map((copy) => (
        <div class="marquee__track" aria-hidden={copy === 1 ? "true" : undefined}>
          {marquee.map((m) => (<><span>{m}</span><Mark size={26} tone="light" bare class="ticker__mark" /></>))}
        </div>
      ))}
    </div>
  </section>

  <!-- ============ MISSION ============ -->
  <section class="section mission">
    <div class="container mission__grid">
      <p class="eyebrow reveal">Our mission</p>
      <p class="mission__statement reveal" style="--d:.08s">
        We believe a student's future shouldn't depend on a bank balance.
        <span class="pill-img"><img src="/images/community-320.webp" alt="" loading="lazy" width="320" height="480" /></span>
        So we stand beside students of Turkish descent facing socioeconomic challenges —{" "}
        <em>covering tuition, opening doors</em>
        <span class="pill-img pill-img--sun" aria-hidden="true"><Mark size={44} tone="light" bare /></span>
        and building a community that lifts each generation higher.
      </p>
      <div class="mission__foot reveal" style="--d:.16s">
        <a class="link-arrow" href="/about">Our story and values <Icon name="arrow" size={18} /></a>
        <span class="mission__meta label">{ORG.taxStatus} · Based in {ORG.state}</span>
      </div>
    </div>
  </section>

  <!-- ============ PROGRAMS ============ -->
  <section class="section section--paper2 programs">
    <div class="container programs__grid">
      <div class="programs__head">
        <div class="programs__sticky">
          <p class="eyebrow reveal">What we do</p>
          <h2 class="h1 reveal" style="--d:.08s">Four ways we <em>open doors.</em></h2>
          <p class="lead reveal" style="--d:.16s">Scholarships are where we begin. Mentorship, partnerships and advocacy are how we make them last.</p>
        </div>
      </div>
      <ol class="programs__list" role="list">
        {PROGRAMS.map((p, i) => (
          <li class="program reveal" style={`--d:${i * 0.06}s`}>
            <a href={programLinks[i]} class="program__link">
              <span class="program__num">0{i + 1}</span>
              <span class="program__body">
                <span class="program__title h3">{p.title}</span>
                <span class="program__text">{p.body}</span>
              </span>
              <span class="program__icon"><Icon name={programIcons[i]} size={26} /></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="section section--ink how">
    <TilePattern id="how-tile" color="var(--paper)" opacity={0.05} />
    <div class="container how__inner">
      <div class="how__head">
        <p class="eyebrow reveal">How the scholarship works</p>
        <h2 class="h1 reveal" style="--d:.08s">Season by season, <em>semester by semester.</em></h2>
      </div>
      <div class="how__arc reveal" aria-hidden="true">
        <svg viewBox="0 0 1200 300" preserveAspectRatio="none">
          <path class="how__path" d="M20 290 C 260 20, 940 20, 1180 290" />
          <line x1="0" y1="290" x2="1200" y2="290" class="how__horizon" />
        </svg>
        <div class="how__sun"></div>
      </div>
      <ol class="how__steps" role="list">
        {steps.map((s, i) => (
          <li class="reveal" style={`--d:${0.1 + i * 0.08}s`}>
            <span class="how__num">{s.n}</span>
            <h3 class="h3">{s.t}</h3>
            <p>{s.b}</p>
          </li>
        ))}
      </ol>
      <div class="how__cta reveal">
        <a class="btn btn--light btn--lg" href="/scholarships">See the current season <Icon name="arrow" size={18} /></a>
        <a class="btn btn--ghost-light btn--lg" href="/scholarships/status">Check an application</a>
      </div>
    </div>
  </section>

  <!-- ============ ELIGIBILITY FACTS ============ -->
  <section class="section facts">
    <div class="container">
      <div class="facts__head">
        <div>
          <p class="eyebrow reveal">Is it for you?</p>
          <h2 class="h1 reveal" style="--d:.08s">Eligibility <em>at a glance.</em></h2>
        </div>
        <p class="lead reveal" style="--d:.16s">
          For students of Turkish descent enrolled — or accepted — at an accredited U.S. college or university and
          facing socioeconomic challenges. Here's what a strong application looks like.
        </p>
      </div>
      <ul class="facts__grid" role="list">
        {facts.map((f, i) => (
          <li class="fact reveal" style={`--d:${i * 0.05}s`}>
            <span class="fact__big">{f.big}</span>
            <span class="fact__small">{f.small}</span>
            <span class="fact__note">{f.note}</span>
          </li>
        ))}
      </ul>
      <p class="facts__foot reveal">
        <a class="link-arrow" href="/scholarships#eligibility">Full eligibility, documents and award terms <Icon name="arrow" size={18} /></a>
        <span class="muted small">Documented disability? You can request an individualized, holistic review.</span>
      </p>
    </div>
  </section>

  <!-- ============ MENTORSHIP ============ -->
  <section class="section section--paper2 mentor">
    <div class="container mentor__grid">
      <figure class="mentor__photo frame-arch reveal">
        <img class="photo" src="/images/mentoring-1000.webp" srcset="/images/mentoring-640.webp 640w, /images/mentoring-1000.webp 1000w" sizes="(max-width: 860px) 90vw, 36vw" alt="A mentor leans in to review notes with a student in a lecture hall" loading="lazy" width="1000" height="1500" />
      </figure>
      <div class="mentor__text">
        <p class="eyebrow reveal">Beyond tuition</p>
        <h2 class="h1 reveal" style="--d:.08s">A scholarship is a start. <em>A mentor is a map.</em></h2>
        <p class="lead reveal" style="--d:.16s">
          Our recipients receive personalized mentoring and career guidance — honest conversations with people who
          have walked the path, about courses, internships, first jobs and what comes next.
        </p>
        <div class="mentor__actions reveal" style="--d:.24s">
          <a class="btn btn--lg" href="/get-involved">Become a mentor <Icon name="arrow" size={18} /></a>
          <a class="link-arrow" href="/about#mentorship">How mentorship works <Icon name="arrow" size={18} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SEASONS HISTORY ============ -->
  <section class="section section--tight seasons">
    <div class="container">
      <div class="seasons__head">
        <p class="eyebrow reveal">Two seasons a year</p>
        <h2 class="h2 reveal" style="--d:.08s">Every Spring. Every Fall. <em>Since 2024.</em></h2>
      </div>
      <ol class="seasons__row reveal" role="list">
        {history.map((s) => (
          <li class:list={["season-pill", `season-pill--${s.state}`]}>
            <a href={`/scholarships/${s.slug}`}>
              <span class="season-pill__term">{s.term}</span>
              <span class="season-pill__year">{s.year}</span>
              <span class="season-pill__state">{s.state === "open" ? "Open now" : s.state === "upcoming" ? "Coming up" : "Closed"}</span>
            </a>
          </li>
        ))}
        {!hasNext && (
          <li class="season-pill season-pill--next">
            <a href="#footer-email">
              <span class="season-pill__term">Next</span>
              <span class="season-pill__year">season</span>
              <span class="season-pill__state">Get notified</span>
            </a>
          </li>
        )}
      </ol>
    </div>
  </section>

  <!-- ============ GIVE ============ -->
  <section class="section give">
    <div class="container">
      <div class="give__card reveal">
        <div class="give__sun" aria-hidden="true"></div>
        <div class="give__text">
          <p class="eyebrow">Give</p>
          <h2 class="display">Your gift becomes <em>someone's next semester.</em></h2>
          <p class="lead">Every scholarship dollar is paid directly to a student's institution as tuition. Springrise is a 501(c)(3) nonprofit — your gift is tax-deductible to the extent permitted by law.</p>
          <a class="btn btn--light btn--lg" href="/donate">Ways to give <Icon name="arrow" size={18} /></a>
        </div>
        <ul class="give__ways" role="list">
          <li>
            <span class="label">Zelle</span>
            <strong>{ORG.zelle.email}</strong>
            <span class="give__sub">Account name: {ORG.zelle.name}</span>
            <button class="give__copy" type="button" data-copy={ORG.zelle.email}><Icon name="copy" size={16} /> <span data-copy-label>Copy email</span></button>
          </li>
          <li>
            <span class="label">Employer matching</span>
            <strong>Double your gift</strong>
            <span class="give__sub">Springrise is registered with Benevity — submit your receipt in your employer's giving portal.</span>
          </li>
          <li>
            <span class="label">Check or bank transfer</span>
            <strong>We'll send the details</strong>
            <span class="give__sub">Email <a href={`mailto:${ORG.emails.donation}`}>{ORG.emails.donation}</a></span>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- HERO ---------- */
  .hero { position: relative; padding-top: clamp(1.5rem, 3vw, 3rem); padding-bottom: clamp(4rem, 8vw, 7rem); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .hero__eyebrow { animation: fade-up 0.9s var(--ease) both; }
  .hero__title { margin-top: 1.6rem; }
  .hero__title .line { display: block; overflow: hidden; padding-bottom: 0.06em; margin-bottom: -0.06em; }
  .hero__title .line > span { display: inline-block; animation: line-up 1.1s var(--ease) both; }
  .hero__title .line:nth-child(2) > span { animation-delay: 0.08s; }
  .hero__title .line:nth-child(3) > span { animation-delay: 0.16s; }
  .hero__title em { color: var(--cobalt); padding-right: 0.08em; }
  .hero__lead { margin-top: 2rem; max-width: 34rem; animation: fade-up 1s var(--ease) 0.35s both; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.5rem; animation: fade-up 1s var(--ease) 0.45s both; }
  @keyframes line-up { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes fade-up { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

  .hero__art { position: relative; aspect-ratio: 4 / 5.1; width: 100%; max-width: 38rem; justify-self: end; }
  .hero__sun {
    position: absolute; right: -3%; top: 3%; width: 60%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle at 42% 38%, #f7cf6a 0%, var(--saffron) 35%, var(--tulip) 85%);
    animation: sun-rise 2.2s var(--ease) 0.2s both;
  }
  @keyframes sun-rise { from { transform: translateY(40%) scale(0.9); opacity: 0; } to { transform: none; opacity: 1; } }
  .hero__photo {
    position: absolute; left: 6%; bottom: 0; width: 70%; height: 90%; margin: 0;
    box-shadow: var(--shadow-lg); animation: fade-up 1.2s var(--ease) 0.15s both;
  }
  .hero__photo::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(35 68 196 / 0) 55%, rgb(13 23 51 / 0.35)); }
  .hero__photo img { object-position: 38% center; }
  .hero__tile {
    position: absolute; right: 0; bottom: 9%; width: 36%; height: 42%; border-radius: var(--arch); overflow: hidden;
    background: linear-gradient(180deg, var(--turquoise), #0f7d7b); color: var(--paper);
    box-shadow: var(--shadow); animation: fade-up 1.2s var(--ease) 0.35s both;
  }
  .hero__tile :global(.hero__tulip) { position: absolute; left: 50%; bottom: 6%; transform: translateX(-50%); }
  .hero__badge {
    position: absolute; left: -2%; top: 3%; width: 25%; height: auto; overflow: visible;
    font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; fill: var(--ink);
    animation: spin 28s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .hero__card { position: absolute; left: -10%; bottom: 6%; width: min(21rem, 72%); animation: fade-up 1.1s var(--ease) 0.6s both; }

  @media (max-width: 960px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__art { justify-self: center; max-width: 34rem; margin-top: 1rem; }
    .hero__card { left: 0; }
  }
  @media (max-width: 560px) {
    .hero__art { aspect-ratio: auto; height: auto; padding-top: 118%; }
    .hero__photo { width: 80%; left: 0; height: 84%; }
    .hero__card { position: relative; left: auto; bottom: auto; width: 100%; margin-top: 1.25rem; }
    .hero__art { padding-top: 0; display: grid; }
    .hero__art > .hero__photo, .hero__art > .hero__sun, .hero__art > .hero__tile, .hero__art > .hero__badge { position: absolute; }
    .hero__art::before { content: ""; display: block; padding-top: 112%; }
    .hero__card { grid-row: 2; }
    .hero__photo { bottom: auto; top: 6%; height: 90%; }
    .hero__tile { bottom: auto; top: 50%; }
    .hero__badge { width: 30%; }
  }

  /* ---------- TICKER ---------- */
  .ticker { background: var(--ink); color: var(--paper); padding-block: 1.35rem; }
  .ticker .marquee { display: flex; }
  .ticker .marquee__track { align-items: center; gap: 2.5rem; padding-right: 2.5rem; flex: none; }
  .ticker span { font-family: var(--font-display); font-style: italic; font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.4rem); line-height: 1; }
  .ticker :global(.ticker__mark) { color: var(--saffron); flex: none; }

  /* ---------- MISSION ---------- */
  .mission__grid { display: grid; gap: 2rem; }
  .mission__statement {
    font-family: var(--font-display); font-size: clamp(2rem, 1.2rem + 3.3vw, 4.4rem); line-height: 1.08; letter-spacing: -0.02em;
    text-wrap: pretty;
  }
  .mission__statement em { color: var(--cobalt); }
  .pill-img {
    display: inline-block; vertical-align: middle; width: 1.9em; height: 0.95em; margin: -0.1em 0.12em 0; border-radius: var(--radius-pill);
    overflow: hidden; background: var(--turquoise); transform: translateY(-0.06em);
  }
  .pill-img img { width: 100%; height: 100%; object-fit: cover; }
  .pill-img--sun { display: inline-grid; place-items: end center; background: radial-gradient(circle at 50% 110%, var(--saffron) 0 45%, var(--tulip) 46% 60%, var(--cobalt) 61%); color: var(--paper); }
  .pill-img--sun :global(svg) { width: 0.8em; height: 0.8em; }
  .mission__foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .mission__meta { color: var(--text-muted); }

  /* ---------- PROGRAMS ---------- */
  .programs__grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 7rem); align-items: start; }
  .programs__sticky { position: sticky; top: 7.5rem; }
  .programs__sticky h2 { margin-top: 1.2rem; }
  .programs__sticky h2 em { color: var(--cobalt); }
  .programs__sticky .lead { margin-top: 1.5rem; }
  .programs__list { list-style: none; padding: 0; border-top: 1px solid var(--line-strong); }
  .program { border-bottom: 1px solid var(--line-strong); }
  .program__link {
    display: grid; grid-template-columns: 4.5rem 1fr auto; gap: 1.25rem; align-items: start;
    padding: 2rem 0.5rem; text-decoration: none; transition: padding 0.5s var(--ease), background-color 0.4s;
    border-radius: var(--radius);
  }
  .program__num { font-family: var(--font-display); font-size: 2.6rem; line-height: 0.9; color: var(--tulip); }
  .program__body { display: grid; gap: 0.6rem; }
  .program__text { color: var(--text-muted); max-width: 34rem; }
  .program__icon {
    display: grid; place-items: center; width: 3.4rem; height: 3.4rem; border-radius: 50%;
    border: 1px solid var(--line-strong); color: var(--ink); transition: background-color 0.4s, color 0.4s, transform 0.5s var(--ease);
  }
  .program__link:hover { background: var(--paper); padding-inline: 1.25rem; }
  .program__link:hover .program__icon { background: var(--cobalt); color: var(--white); border-color: var(--cobalt); transform: rotate(-8deg); }
  @media (max-width: 900px) {
    .programs__grid { grid-template-columns: 1fr; }
    .programs__sticky { position: static; }
  }
  @media (max-width: 520px) {
    .program__link { grid-template-columns: 3rem 1fr; }
    .program__icon { display: none; }
    .program__num { font-size: 2rem; }
  }

  /* ---------- HOW ---------- */
  .how { position: relative; overflow: hidden; }
  .how__inner { position: relative; }
  .how__head { display: grid; gap: 1.2rem; max-width: 50rem; }
  .how__head h2 em { color: var(--saffron); }
  .how__arc { position: relative; margin-top: clamp(2.5rem, 5vw, 4.5rem); height: clamp(90px, 14vw, 190px); }
  .how__arc svg { width: 100%; height: 100%; overflow: visible; }
  .how__path { fill: none; stroke: rgb(247 242 233 / 0.35); stroke-width: 1.2; stroke-dasharray: 4 8; vector-effect: non-scaling-stroke; }
  .how__horizon { stroke: rgb(247 242 233 / 0.3); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .how__sun {
    position: absolute; left: 50%; top: 0; width: clamp(56px, 7vw, 96px); aspect-ratio: 1; border-radius: 50%;
    transform: translate(-50%, -18%);
    background: radial-gradient(circle at 42% 38%, #f7cf6a, var(--saffron) 40%, var(--tulip) 90%);
    box-shadow: 0 0 80px 10px rgb(240 181 63 / 0.25);
  }
  @supports (animation-timeline: view()) {
    .how__sun { animation: sun-path linear both; animation-timeline: view(); animation-range: entry 10% exit 40%; }
    @keyframes sun-path {
      0% { left: 6%; top: 78%; }
      25% { left: 27%; top: 14%; }
      50% { left: 50%; top: 0%; }
      75% { left: 73%; top: 14%; }
      100% { left: 94%; top: 78%; }
    }
  }
  .how__steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(1.25rem, 3vw, 3rem); list-style: none; padding: 0; margin-top: 2.5rem; }
  .how__steps li { display: grid; gap: 0.85rem; align-content: start; padding-top: 1.5rem; border-top: 1px solid rgb(247 242 233 / 0.2); }
  .how__num { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.14em; color: var(--saffron); }
  .how__steps p { color: rgb(247 242 233 / 0.72); font-size: 0.98rem; }
