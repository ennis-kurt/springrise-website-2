---
import Site from "../layouts/Site.astro";
import RisingField from "../components/RisingField.astro";
import Split from "../components/Split.astro";
import SeasonSpotlight from "../components/SeasonSpotlight.astro";
import AidRing from "../components/viz/AidRing.astro";
import DollarGrid from "../components/viz/DollarGrid.astro";
import ReachDots from "../components/viz/ReachDots.astro";
import YearBars from "../components/viz/YearBars.astro";
import GiftPicker from "../components/viz/GiftPicker.astro";
import PillarGlyph from "../components/PillarGlyph.astro";
import { siteData } from "../lib/public";
import { COMMUNITY, FINANCE, ORG, PILLARS, REACH } from "../lib/facts";

const site = await siteData();
const s = site.spotlight;
const [y24, y25] = REACH.students;
const purpose = "We exist to empower students of Turkish descent to become self-confident, socially conscious, life-long learners — and to pursue careers that matter to them.";
const ticker = ["Scholarships", "Internships", "Mentorship", "97.1% direct aid", "25 scholars in 2025", "Spring & Fall seasons", "501(c)(3) public charity"];
const steps = [
  { t: "Announce", b: "Each Spring and Fall we open a new season and publish its dates and criteria here." },
  { t: "Apply", b: "One guided online application — your details, your studies, two references and five PDFs." },
  { t: "Review", b: "The Board reviews every application as a whole: academics, need, resilience, leadership, service." },
  { t: "Award", b: "Scholarships are paid directly to your college or university as tuition, one semester at a time." },
];
---
<Site site={site}>
  <!-- HERO -->
  <section class="hero night">
    <RisingField groups={[
      { count: y25.count, color: "#c5f04a", label: `${y25.year}`, weight: 1.12 },
      { count: y24.count, color: "#a99cff", label: `${y24.year}`, weight: 0.86 },
    ]} />
    <div class="hero__veil" aria-hidden="true"></div>
    <div class="wrap hero__inner">
      <p class="kicker rv">Springrise Foundation · New Jersey · 501(c)(3)</p>
      <h1 class="t-giant hero__title">
        <Split text="Room to" /><br /><Split text="rise." class="hl" start={2} />
      </h1>
      <div class="hero__foot">
        <p class="lead rv" style="--d:.35s">
          Tuition scholarships, internships and mentorship for students of Turkish descent in U.S. higher education —
          so talent, not circumstance, decides how far they go.
        </p>
        <div class="hero__cta rv" style="--d:.45s">
          {s?.phase === "open"
            ? <a class="btn btn--shoot btn--lg" href={`/scholarships/${s.slug}/apply`} data-magnetic>Apply for {s.term} {s.year} <span class="arr">↗</span></a>
            : <a class="btn btn--shoot btn--lg" href="/scholarships" data-magnetic>Scholarships <span class="arr">↗</span></a>}
          <a class="btn btn--line-night btn--lg" href="/give">Fund a student</a>
        </div>
      </div>
      <p class="hero__legend rv" style="--d:.6s">
        <span><i class="dot dot--now"></i>{y25.count} scholars in {y25.year}</span>
        <span><i class="dot dot--then"></i>{y24.count} in {y24.year}</span>
        <span class="muted">Every stem is a student we've backed.</span>
      </p>
    </div>
  </section>

  <!-- TICKER -->
  <div class="ticker" aria-label="At a glance">
    <div class="marquee">
      {[0, 1].map((k) => (
        <div class="marquee__run" aria-hidden={k ? "true" : undefined}>
          {ticker.map((t) => (<><span>{t}</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 0c1 6 4 9 10 10-6 1-9 4-10 10-1-6-4-9-10-10 6-1 9-4 10-10Z" /></svg></>))}
        </div>
      ))}
    </div>
  </div>

  <!-- PURPOSE -->
  <section class="section purpose">
    <div class="wrap purpose__grid">
      <div class="purpose__side">
        <p class="kicker">Our purpose</p>
        <a class="link small" href="/governance#article-i">From Article I of our by-laws →</a>
      </div>
      <p class="purpose__text" data-scrub>
        {purpose.split(" ").map((w, i) => <span style={`--k:${i}`}>{w} </span>)}
      </p>
    </div>
  </section>

  <!-- PILLARS -->
  <section class="section pillars" aria-labelledby="pillars-h">
    <div class="wrap">
      <div class="head-row">
        <div>
          <p class="kicker rv">What we do</p>
          <h2 class="t-1 rv" id="pillars-h" style="--d:.06s">Three ways we<br />clear the path.</h2>
        </div>
        <p class="lead rv" style="--d:.12s">A scholarship keeps a student enrolled. An internship opens a first door. A mentor helps them see which doors are worth opening.</p>
      </div>
      <ol class="pillar-row" role="list">
        {PILLARS.map((p, i) => (
          <li class:list={["pillar rv", `pillar--${p.key}`]} style={`--d:${i * 0.08}s`} tabindex="0">
            <span class="pillar__n mono">0{i + 1}</span>
            <PillarGlyph kind={p.key} />
            <h3 class="t-2 pillar__t">{p.title}</h3>
            <p class="pillar__line">{p.line}</p>
            <p class="pillar__detail">{p.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- IMPACT -->
  <section class="section night grid-bg impact" aria-labelledby="impact-h">
    <div class="wrap">
      <div class="head-row">
        <div>
          <p class="kicker rv">Impact, in the open</p>
          <h2 class="t-1 rv" id="impact-h" style="--d:.06s">Growth you<br />can <span class="hl">count.</span></h2>
        </div>
        <a class="btn btn--line-night rv" href="/impact">Full financial summary <span class="arr">↗</span></a>
      </div>

      <div class="impact__grid">
        <article class="tile tile--reach rv">
          <p class="kicker kicker--plain">Students reached</p>
          <p class="tile__big"><span data-count={y25.count}>0</span></p>
          <p class="tile__cap">scholars supported in {y25.year} — <b class="hl">+{(REACH.growth * 100).toFixed(1)}%</b> more than {y24.year}.</p>
          <ReachDots />
        </article>

        <article class="tile tile--ring rv" style="--d:.08s">
          <AidRing size={300} />
          <div>
            <p class="kicker kicker--plain">Mission efficiency · FY 2025</p>
            <p class="tile__quote">For every <b>$1</b> Springrise spends, <b class="hl">97¢</b> goes directly to students.</p>
          </div>
        </article>

        <article class="tile tile--dollar rv">
          <p class="kicker kicker--plain">Where one dollar goes</p>
          <p class="tile__quote tile__quote--left">Lean by design: <span class="hl">$2,710</span> of FY 2025 spending covered operations and legal.</p>
          <DollarGrid />
        </article>

        <article class="tile tile--bars rv" style="--d:.08s">
          <YearBars label="Contributions & donations" values={FINANCE.contributions} tone="lilac" />
          <YearBars label="Scholarships paid to schools" values={FINANCE.scholarships} tone="shoot" />
          <p class="small muted">Scholarship giving grew faster than giving itself — by design. {FINANCE.note}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- WHO WE SERVE -->
  <section class="section who" aria-labelledby="who-h">
    <div class="wrap who__grid">
      <div>
        <p class="kicker rv">Who we serve</p>
        <h2 class="t-1 rv" id="who-h" style="--d:.06s">More promise<br />than resources.</h2>
      </div>
      <dl class="who__list">
        {COMMUNITY.map((c, i) => (
          <div class="rv" style={`--d:${i * 0.08}s`}>
            <dt class="mono">{c.k}</dt>
            <dd>{c.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- SEASON -->
  <section class="section season bone-2" aria-labelledby="season-h">
    <div class="wrap season__grid">
      <div class="season__left">
        <p class="kicker rv">Scholarship seasons</p>
        <h2 class="t-1 rv" id="season-h" style="--d:.06s">Twice a year,<br />a new cohort rises.</h2>
        <ol class="steps" role="list">
          {steps.map((st, i) => (
            <li class="rv" style={`--d:${0.1 + i * 0.08}s`}>
              <span class="steps__n mono">0{i + 1}</span>
              <div><h3 class="t-3">{st.t}</h3><p class="muted">{st.b}</p></div>
            </li>
          ))}
        </ol>
      </div>
      <div class="season__right rv" style="--d:.1s">
        <SeasonSpotlight season={s} />
      </div>
    </div>
  </section>

  <!-- JOIN -->
  <section class="section night join" aria-labelledby="join-h">
    <div class="wrap">
      <div class="head-row">
        <div>
          <p class="kicker rv">Get involved</p>
          <h2 class="t-1 rv" id="join-h" style="--d:.06s">Lend your time,<br />your network, your <span class="hl">judgment.</span></h2>
        </div>
      </div>
      <ul class="join__grid" role="list">
        {[
          { t: "Become a mentor", b: "Guide a student through the choices that shape a career.", href: "/get-involved#mentor" },
          { t: "Open an internship", b: "Help us coordinate real work experience in your field.", href: "/get-involved#internships" },
          { t: "Join the Board", b: "Shape the foundation's direction as a trustee.", href: "/get-involved#board" },
          { t: "Become a donor", b: "Fund tuition directly — one semester at a time.", href: "/give" },
        ].map((j, i) => (
          <li class="rv" style={`--d:${i * 0.06}s`}>
            <a class="join__card" href={j.href}>
              <span class="join__n mono">0{i + 1}</span>
              <span class="t-3">{j.t}</span>
              <span class="muted">{j.b}</span>
              <span class="join__arr" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <!-- GIVE -->
  <section class="section give paper" aria-labelledby="give-h">
    <div class="wrap give__grid">
      <div class="give__left">
        <p class="kicker rv">Give</p>
        <h2 class="t-1 rv" id="give-h" style="--d:.06s">Choose what your gift <span class="hl-dawn">becomes.</span></h2>
        <p class="lead rv" style="--d:.12s">Every scholarship is paid straight to a student's school. Springrise is a 501(c)(3) public charity — your gift is tax-deductible.</p>
        <div class="give__ways rv" style="--d:.18s">
          <button class="way" type="button" data-copy={ORG.zelle.to}>
            <span class="mono">Zelle</span><b>{ORG.zelle.to}</b><span class="way__act" data-copy-label>Copy</span>
          </button>
          <a class="way" href="/give#matching"><span class="mono">Employer match</span><b>Benevity</b><span class="way__act">How →</span></a>
        </div>
      </div>
      <div class="give__right rv" style="--d:.1s">
        <GiftPicker />
        <a class="btn btn--lg" href="/give">All ways to give <span class="arr">↗</span></a>
      </div>
    </div>
  </section>

</Site>

<script>
  // Scroll-scrubbed purpose statement: words light up as it passes through the viewport.
  const el = document.querySelector<HTMLElement>("[data-scrub]");
  if (el && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const words = [...el.querySelectorAll<HTMLElement>("span")];
    const update = () => {
      const r = el.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.85 - r.top) / (r.height + innerHeight * 0.35)));
      const lit = Math.round(p * words.length * 1.15);
      words.forEach((w, i) => w.classList.toggle("on", i < lit));
    };
    update();
    addEventListener("scroll", update, { passive: true });
  } else el?.querySelectorAll("span").forEach((w) => w.classList.add("on"));
</script>

<style>
  /* HERO */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; padding-top: 7rem; }
  .hero__veil { position: absolute; inset: 0; pointer-events: none; background:
    radial-gradient(70% 55% at 18% 88%, rgb(16 15 26 / 0.92) 0%, rgb(16 15 26 / 0.6) 45%, rgb(16 15 26 / 0) 75%),
    linear-gradient(0deg, rgb(16 15 26 / 0.75) 0%, rgb(16 15 26 / 0) 30%),
    linear-gradient(180deg, rgb(16 15 26 / 0.55) 0%, rgb(16 15 26 / 0) 30%); }
  .hero__inner { position: relative; padding-bottom: clamp(2rem, 5vw, 3.5rem); display: grid; gap: clamp(1.2rem, 2.5vw, 2rem); }
  .hero__title { margin-top: 0.5rem; }
  .hero__foot { display: grid; grid-template-columns: minmax(0, 1.2fr) auto; gap: 2rem 4rem; align-items: end; }
  .hero__foot .lead { color: rgb(243 240 232 / 0.8); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .hero__legend { display: flex; flex-wrap: wrap; gap: 0.5rem 1.6rem; padding-top: 1.2rem; border-top: 1px solid var(--night-line); font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.06em; text-transform: uppercase; color: rgb(243 240 232 / 0.85); }
  .hero__legend .muted { text-transform: none; letter-spacing: 0; font-family: var(--font-sans); font-size: 0.88rem; }
  .dot { display: inline-block; width: 0.55rem; height: 0.55rem; border-radius: 50%; margin-right: 0.55rem; vertical-align: 1px; }
  .dot--now { background: var(--shoot); box-shadow: 0 0 12px var(--shoot); } .dot--then { background: var(--lilac); }
  @media (max-width: 900px) { .hero__foot { grid-template-columns: 1fr; } .hero__veil { background: linear-gradient(0deg, rgb(16 15 26 / 0.55) 0%, rgb(16 15 26 / 0.78) 35%, rgb(16 15 26 / 0.5) 55%, rgb(16 15 26 / 0) 80%); } }

  /* TICKER */
  .ticker { background: var(--shoot); color: var(--night); padding-block: 1.1rem; overflow: hidden; }
  .ticker span { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.4rem, 1rem + 1.6vw, 2.4rem); letter-spacing: -0.035em; white-space: nowrap; }
  .ticker svg { width: 1.3rem; height: 1.3rem; fill: var(--night); flex: none; }

  /* PURPOSE */
  .purpose__grid { display: grid; grid-template-columns: minmax(0, 0.28fr) minmax(0, 1fr); gap: 2rem clamp(2rem, 5vw, 5rem); }
  .purpose__side { display: grid; gap: 1rem; align-content: start; justify-items: start; padding-top: 0.8rem; }
  .purpose__text { font-family: var(--font-display); font-weight: 650; font-size: clamp(2rem, 1rem + 3.6vw, 4.6rem); line-height: 1.04; letter-spacing: -0.04em; }
  .purpose__text span { color: rgb(16 15 26 / 0.5); transition: color 0.35s; }
  .purpose__text span.on { color: var(--night); }
  @media (max-width: 800px) { .purpose__grid { grid-template-columns: 1fr; } }

  /* PILLARS */
  .pillar-row { display: flex; gap: 0.8rem; min-height: 32rem; }
  .pillar {
    position: relative; flex: 1 1 0; display: flex; flex-direction: column; gap: 0.9rem; padding: clamp(1.4rem, 2.5vw, 2.2rem);
    border-radius: var(--r-lg); background: var(--paper); border: 1px solid var(--line); overflow: hidden; outline: none;
    transition: flex-grow 0.8s var(--ease), background-color 0.5s, color 0.5s, transform 0.8s var(--ease), opacity 1.1s var(--ease);
  }
  .pillar:hover, .pillar:focus-visible { flex-grow: 1.7; background: var(--night); color: var(--bone); }
  .pillar__n { font-size: 0.78rem; color: var(--text-faint); }
  .pillar:hover .pillar__n, .pillar:focus-visible .pillar__n { color: var(--shoot); }
  .pillar__t { margin-top: auto; }
  .pillar__line { font-size: 1.05rem; max-width: 26rem; }
  .pillar__detail { max-width: 26rem; color: var(--night-muted); max-height: 0; opacity: 0; overflow: hidden; transition: max-height 0.8s var(--ease), opacity 0.6s; }
  .pillar:hover .pillar__detail, .pillar:focus-visible .pillar__detail { max-height: 8rem; opacity: 1; }
  @media (max-width: 900px) {
    .pillar-row { flex-direction: column; min-height: 0; }
    .pillar { min-height: 0; overflow: visible; }
    .pillar__t { margin-top: 1rem; }
    .pillar__detail { max-height: none; opacity: 1; color: var(--text-muted); }
    .pillar:hover .pillar__detail { color: var(--night-muted); }
  }

  /* IMPACT */
  .impact__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1rem; }
  .tile { background: rgb(25 24 42 / 0.86); border: 1px solid var(--night-line); border-radius: var(--r-lg); padding: clamp(1.4rem, 3vw, 2.4rem); display: grid; gap: 1.2rem; align-content: start; backdrop-filter: blur(6px); }
  .tile--reach { grid-column: span 7; }
  .tile--ring { grid-column: span 5; justify-items: center; text-align: center; }
  .tile--dollar { grid-column: span 5; }
  .tile--bars { grid-column: span 7; gap: 2rem; }
  .tile__big { font-family: var(--font-display); font-weight: 800; font-size: clamp(6rem, 4rem + 8vw, 12rem); line-height: 0.8; letter-spacing: -0.07em; color: var(--shoot); }
  .tile__cap { font-size: 1.1rem; max-width: 30rem; }
  .tile__quote--left { text-align: left; margin-inline: 0 !important; max-width: 24rem !important; }
  .tile__quote { font-family: var(--font-display); font-weight: 650; font-size: var(--fs-3); letter-spacing: -0.025em; line-height: 1.15; margin-top: 0.6rem; max-width: 20rem; margin-inline: auto; }
  @media (max-width: 1000px) {
    .tile--reach, .tile--ring, .tile--dollar, .tile--bars { grid-column: 1 / -1; }
  }

  /* WHO */
  .who__grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 7rem); align-items: end; }
  .who__list { display: grid; }
  .who__list div { display: grid; grid-template-columns: 9rem 1fr; gap: 1.5rem; padding-block: 1.6rem; border-top: 1px solid var(--line-strong); }
  .who__list div:last-child { border-bottom: 1px solid var(--line-strong); }
  .who__list dt { font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); padding-top: 0.45rem; }
  .who__list dd { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.85rem); line-height: 1.2; letter-spacing: -0.025em; }
  @media (max-width: 900px) { .who__grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .who__list div { grid-template-columns: 1fr; gap: 0.4rem; } }

  /* SEASON */
  .season__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .season__left { display: grid; gap: 1.2rem; }
  .season__right { position: sticky; top: 6.5rem; }
  .steps { margin-top: 1.5rem; display: grid; }
  .steps li { position: relative; display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1.4rem 0; border-top: 1px solid var(--line-strong); }
  .steps__n { font-size: 0.8rem; padding-top: 0.45rem; color: var(--shoot-ink); }
  .steps .muted { margin-top: 0.35rem; }
  @media (max-width: 960px) { .season__grid { grid-template-columns: 1fr; } .season__right { position: static; } }

  /* GIVE */
  .give__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .give__left { display: grid; gap: 1.3rem; }
  .give__right { display: grid; gap: 1.8rem; justify-items: start; }
  .give__right :global(.gift) { width: 100%; }
  .give__ways { display: grid; gap: 0.6rem; margin-top: 0.6rem; max-width: 30rem; }
  .way { display: grid; grid-template-columns: 8.5rem 1fr auto; gap: 1rem; align-items: center; padding: 1rem 1.2rem; border-radius: var(--r); border: 1.5px solid var(--line-strong); text-decoration: none; text-align: left; transition: border-color 0.3s, background-color 0.3s; }
  .way:hover { border-color: var(--night); background: var(--bone); }
  .way .mono { font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); }
  .way b { font-weight: 600; overflow-wrap: anywhere; }
  .way__act { font-size: 0.85rem; font-weight: 600; color: var(--lilac-deep); }
  @media (max-width: 960px) { .give__grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .way { grid-template-columns: 1fr auto; } .way .mono { grid-column: 1 / -1; } }

  /* JOIN */
  .join__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.8rem; }
  .join__card { position: relative; display: grid; gap: 0.8rem; align-content: start; min-height: 17rem; padding: 1.6rem; border-radius: var(--r-lg); border: 1px solid var(--night-line-strong); text-decoration: none; transition: background-color 0.4s, color 0.4s, transform 0.5s var(--ease); }
  .join__card:hover { background: var(--shoot); color: var(--night); transform: translateY(-6px); }
  .join__card:hover .muted { color: rgb(16 15 26 / 0.75); }
  .join__n { font-size: 0.76rem; color: var(--night-muted); margin-bottom: auto; }
  .join__card .t-3 { margin-top: 4rem; }
  .join__arr { position: absolute; top: 1.3rem; right: 1.4rem; font-size: 1.4rem; transition: transform 0.5s var(--ease); }
  .join__card:hover .join__arr { transform: rotate(45deg); }
  @media (max-width: 1000px) { .join__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .join__grid { grid-template-columns: 1fr; } .join__card { min-height: 12rem; } .join__card .t-3 { margin-top: 2rem; } }
</style>
