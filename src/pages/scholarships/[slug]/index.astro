---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Icon from "../../../components/Icon.astro";
import Mark from "../../../components/Mark.astro";
import Requirements from "../../../components/scholarship/Requirements.astro";
import { getSiteState } from "../../../lib/site";
import { daysUntil, fmtDate, fmtDateTime, paragraphs } from "../../../lib/seasons";
import { ORG } from "../../../lib/content";

const site = await getSiteState();
const season = site.seasons.find((s) => s.slug === Astro.params.slug);
if (!season) return Astro.rewrite("/404");

const now = Date.now();
const opens = season.opens_at ? Date.parse(season.opens_at) : null;
const closes = season.closes_at ? Date.parse(season.closes_at) : null;
const progress = opens && closes ? Math.min(100, Math.max(0, ((now - opens) / (closes - opens)) * 100)) : 100;
const stateLabel = season.state === "open" ? "Applications open" : season.state === "upcoming" ? "Opening soon" : "Applications closed";
const days = season.state === "open" ? daysUntil(season.closes_at) : season.state === "upcoming" ? daysUntil(season.opens_at) : 0;
const archived = season.status === "archived";
---
<BaseLayout title={season.title} description={season.summary || `${season.title} — Springrise Foundation`} site={site}>
  <section class="season-hero">
    <div class="container">
      <nav class="crumbs reveal" aria-label="Breadcrumb"><a href="/scholarships">Scholarships</a><span aria-hidden="true">/</span><span aria-current="page">{season.term} {season.year}</span></nav>
      <div class="season-hero__grid">
        <div>
          <p class="chip reveal" style="--d:.04s"><span class:list={["dot", `dot--${season.state}`]}></span>{stateLabel}</p>
          <h1 class="mega reveal" style="--d:.08s">{season.term} <em>{season.year}</em></h1>
          <p class="season-hero__sub reveal" style="--d:.12s">{season.title}</p>
        </div>
        <div class="season-hero__meta reveal" style="--d:.16s">
          {season.summary && <p class="lead">{season.summary}</p>}
          {!archived && opens && closes && (
            <div class="window">
              <div class="window__bar" role="img" aria-label={`Application window ${Math.round(progress)}% elapsed`}>
                <span style={`width:${progress}%`}></span>
                <i style={`left:${progress}%`} class:list={[season.state !== "open" && "is-hidden"]}></i>
              </div>
              <div class="window__labels">
                <span><b>Opens</b>{fmtDate(season.opens_at)}</span>
                <span><b>Closes</b>{fmtDate(season.closes_at)}</span>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="season-body">
    <div class="container season-body__grid">
      <div class="season-body__main">
        {paragraphs(season.announcement).length > 0 && (
          <div class="prose reveal">
            <p class="eyebrow">Announcement</p>
            {paragraphs(season.announcement).map((p) => <p>{p}</p>)}
          </div>
        )}
        {archived && (
          <div class="notice reveal">This season has been archived. Its details are kept for reference — see the <a href="/scholarships">current season</a>.</div>
        )}
        <dl class="dates reveal">
          <div><dt><Icon name="calendar" size={18} /> Applications open</dt><dd>{season.opens_at ? fmtDateTime(season.opens_at) : "—"}</dd></div>
          <div><dt><Icon name="clock" size={18} /> Deadline</dt><dd>{season.closes_at ? fmtDateTime(season.closes_at) : "—"}</dd></div>
          {season.decision_at && <div><dt><Icon name="spark" size={18} /> Decisions expected</dt><dd>{fmtDate(season.decision_at)}</dd></div>}
          <div><dt><Icon name="school" size={18} /> Paid to</dt><dd>Your institution, as tuition</dd></div>
        </dl>
      </div>

      <aside class="apply-card reveal" style="--d:.1s">
        <Mark size={44} />
        {season.state === "open" && (
          <>
            <p class="apply-card__big"><b>{days}</b> {days === 1 ? "day" : "days"} left</p>
            <p class="muted">Deadline {fmtDateTime(season.closes_at)}. Have your PDFs ready and you can finish in one sitting — your progress saves as you go.</p>
            <a class="btn btn--cobalt btn--lg" href={`/scholarships/${season.slug}/apply`}>Start your application <Icon name="arrow" size={18} /></a>
            <a class="link-arrow" href="#documents">Checklist of documents <Icon name="arrow" size={16} /></a>
          </>
        )}
        {season.state === "upcoming" && (
          <>
            <p class="apply-card__big">Opens in <b>{days}</b> {days === 1 ? "day" : "days"}</p>
            <p class="muted">Applications open {fmtDateTime(season.opens_at)}. Get your documents ready now, and we'll email you the moment it opens.</p>
            <form class="alert-form" action="/api/subscribe" method="post" data-ajax data-success="Done — we'll email you when applications open.">
              <input type="hidden" name="source" value={`season-alert:${season.slug}`} />
              <div class="honeypot" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
              <label class="visually-hidden" for="alert-email">Email address</label>
              <input class="input" id="alert-email" name="email" type="email" required placeholder="you@example.com" autocomplete="email" />
              <button class="btn" type="submit">Remind me</button>
              <p class="small" role="status" aria-live="polite" data-form-msg></p>
            </form>
            <a class="link-arrow" href={`/scholarships/${season.slug}/apply?preview=1`}>Preview the application <Icon name="arrow" size={16} /></a>
          </>
        )}
        {season.state === "closed" && (
          <>
            <p class="apply-card__big">This season is <b>closed</b></p>
            <p class="muted">Applications are no longer being accepted for {season.term} {season.year}. Need to send additional documents? Email <a href={`mailto:${ORG.emails.scholarship}`}>{ORG.emails.scholarship}</a> with your reference.</p>
            <a class="btn btn--lg" href="/scholarships">See the current season <Icon name="arrow" size={18} /></a>
            <a class="link-arrow" href="/scholarships/status">Check an application's status <Icon name="arrow" size={16} /></a>
          </>
        )}
      </aside>
    </div>
  </section>

  <Requirements eligibility={season.eligibility} requirements={season.requirements} />
</BaseLayout>

<style>
  .season-hero { padding-top: clamp(2rem, 4vw, 3.5rem); padding-bottom: clamp(2.5rem, 5vw, 4.5rem); border-bottom: 1px solid var(--line); }
  .crumbs { display: flex; gap: 0.6rem; font-size: 0.9rem; color: var(--text-muted); }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--cobalt); }
  .season-hero__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(2rem, 5vw, 5rem); align-items: end; margin-top: 2.5rem; }
  .season-hero h1 { margin-top: 1.25rem; }
  .season-hero h1 em { color: var(--cobalt); }
  .season-hero__sub { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-top: 1rem; }
  .season-hero__meta { display: grid; gap: 2rem; }
  .window { display: grid; gap: 0.8rem; }
  .window__bar { position: relative; height: 6px; border-radius: 6px; background: var(--paper-3); }
  .window__bar span { position: absolute; inset: 0 auto 0 0; border-radius: 6px; background: linear-gradient(90deg, var(--saffron), var(--tulip)); }
  .window__bar i { position: absolute; top: 50%; width: 18px; height: 18px; border-radius: 50%; background: var(--tulip); border: 3px solid var(--paper); transform: translate(-50%, -50%); box-shadow: var(--shadow-sm); }
  .window__bar i.is-hidden { display: none; }
  .window__labels { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.92rem; }
  .window__labels span { display: grid; }
  .window__labels span:last-child { text-align: right; }
  .window__labels b { font-family: var(--font-mono); font-weight: 500; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }

  .season-body { padding-block: clamp(3rem, 6vw, 5.5rem); }
  .season-body__grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.85fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .season-body__main { display: grid; gap: 2.5rem; }
  .season-body__main .notice a { color: var(--cobalt); }
  .dates { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line-strong); border-left: 1px solid var(--line-strong); }
  .dates div { padding: 1.4rem; border-right: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); display: grid; gap: 0.5rem; }
  .dates div:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .dates dt { display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }
  .dates dd { font-family: var(--font-display); font-size: 1.45rem; line-height: 1.2; }
  .apply-card {
    position: sticky; top: 7rem; display: grid; gap: 1.1rem; justify-items: start; padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg); background: var(--white); border: 1px solid var(--line); box-shadow: var(--shadow);
  }
  .apply-card .btn { width: 100%; }
  .apply-card a:not(.btn) { color: var(--cobalt); }
  .apply-card__big { font-family: var(--font-display); font-size: 2.2rem; line-height: 1.05; }
  .apply-card__big b { font-weight: 400; color: var(--cobalt); }
  .alert-form { display: grid; gap: 0.6rem; width: 100%; }
  @media (max-width: 900px) {
    .season-hero__grid, .season-body__grid { grid-template-columns: 1fr; }
    .apply-card { position: static; }
  }
  @media (max-width: 520px) { .dates { grid-template-columns: 1fr; } }
</style>
