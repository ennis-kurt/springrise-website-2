---
import Site from "../../../layouts/Site.astro";
import Requirements from "../../../components/Requirements.astro";
import { seasonForRequest, siteData } from "../../../lib/public";
import { daysFrom, formatDate, formatDateTime, paragraphs } from "../../../lib/season";
import { ORG } from "../../../lib/facts";

const site = await siteData();
const { season: s, preview } = await seasonForRequest(Astro.params.slug!, Astro.request, site);
if (!s) return Astro.rewrite("/404");

const opens = s.opens_at ? Date.parse(s.opens_at) : null;
const closes = s.closes_at ? Date.parse(s.closes_at) : null;
const pct = opens && closes ? Math.min(100, Math.max(0, ((Date.now() - opens) / (closes - opens)) * 100)) : 100;
const label = s.phase === "open" ? "Applications open" : s.phase === "upcoming" ? "Opening soon" : "Closed";
const target = s.phase === "open" ? s.closes_at : s.phase === "upcoming" ? s.opens_at : null;
---
<Site title={s.title} description={s.headline || s.title} site={site} noindex={preview}>
  {preview && <div class="preview-bar"><div class="wrap"><b>Staff preview.</b> This season is a <b>{s.status}</b> and isn't visible to the public. <a href={`/staff/seasons/${s.slug}`}>Edit season →</a></div></div>}

  <section class="ss">
    <div class="wrap">
      <nav class="crumbs rv" aria-label="Breadcrumb"><a href="/scholarships">Scholarships</a><span aria-hidden="true">/</span><span aria-current="page">{s.term} {s.year}</span></nav>
      <div class="ss__grid">
        <div>
          <span class="chip rv"><span class:list={["pulse", `pulse--${s.phase}`]}></span>{label}</span>
          <h1 class="t-giant ss__title rv" style="--d:.05s">{s.term}<br /><span class="hl">{s.year}</span></h1>
        </div>
        <div class="ss__side rv" style="--d:.15s">
          {s.headline && <p class="lead">{s.headline}</p>}
          {opens && closes && s.status !== "archived" && (
            <div class="window" role="img" aria-label={`Application window from ${formatDate(s.opens_at)} to ${formatDate(s.closes_at)}`}>
              <div class="window__bar"><span style={`--w:${pct}%`}></span>{s.phase === "open" && <i style={`left:${pct}%`}></i>}</div>
              <div class="window__ends"><span><b>Opens</b>{formatDate(s.opens_at)}</span><span><b>Closes</b>{formatDate(s.closes_at)}</span></div>
            </div>
          )}
          {target && (
            <div class="clock" data-countdown={target}>
              <span class="mono clock__lab">{s.phase === "open" ? "Closes in" : "Opens in"}</span>
              <span class="clock__v"><b data-d>{daysFrom(target)}</b>d <b data-h>00</b>h <b data-m>00</b>m <b data-s>00</b>s</span>
            </div>
          )}
          <div class="ss__cta">
            {s.phase === "open" && <a class="btn btn--shoot btn--lg" href={`/scholarships/${s.slug}/apply`} data-magnetic>Start your application <span class="arr">↗</span></a>}
            {s.phase === "upcoming" && <><a class="btn btn--shoot btn--lg" href="#alert-email">Remind me when it opens</a><a class="btn btn--line btn--lg" href={`/scholarships/${s.slug}/apply?preview=1`}>Preview the form</a></>}
            {s.phase === "closed" && <><a class="btn btn--lg" href="/scholarships">Current season</a><a class="btn btn--line btn--lg" href="/scholarships/status">Check a status</a></>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--s">
    <div class="wrap ss__body">
      <div class="prose rv">
        <p class="kicker">Announcement</p>
        {paragraphs(s.announcement).length ? paragraphs(s.announcement).map((p) => <p>{p}</p>) : <p>{s.headline}</p>}
        {s.status === "archived" && <p class="muted">This season is part of our archive and is no longer accepting applications.</p>}
      </div>
      <dl class="facts rv" style="--d:.1s">
        <div><dt>Opens</dt><dd>{s.opens_at ? formatDateTime(s.opens_at) : "To be announced"}</dd></div>
        <div><dt>Deadline</dt><dd>{s.closes_at ? formatDateTime(s.closes_at) : "To be announced"}</dd></div>
        {s.decision_at && <div><dt>Decisions</dt><dd>{formatDate(s.decision_at)}</dd></div>}
        <div><dt>Paid to</dt><dd>Your college or university</dd></div>
        <div><dt>Questions</dt><dd><a href={`mailto:${ORG.email.scholarship}`}>{ORG.email.scholarship}</a></dd></div>
      </dl>
    </div>
  </section>

  <Requirements eligibility={s.eligibility} requirements={s.requirements} />
</Site>

<style>
  .preview-bar { position: relative; z-index: 70; background: var(--dawn); color: var(--night); font-size: 0.92rem; padding: 0.7rem 0; margin-top: 5.2rem; }
  .preview-bar a { font-weight: 560; margin-left: 0.5rem; }
  .ss { background: linear-gradient(180deg, var(--paper), var(--bone)); border-bottom: 1px solid var(--line); padding-top: clamp(8rem, 12vw, 10.5rem); padding-bottom: clamp(3rem, 6vw, 5rem); }
  .preview-bar + .ss { background: linear-gradient(180deg, var(--paper), var(--bone)); border-bottom: 1px solid var(--line); padding-top: 3rem; }
  .crumbs { display: flex; gap: 0.6rem; font-size: 0.9rem; color: var(--text-muted); }
  .crumbs a { text-decoration: none; } .crumbs a:hover { color: var(--shoot-deep); }
  .ss__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: end; margin-top: 2.5rem; }
  .ss__title { margin-top: 1.4rem; }
  .ss__side { display: grid; gap: 1.8rem; }
  .window { display: grid; gap: 0.8rem; }
  .window__bar { position: relative; height: 8px; border-radius: 8px; background: var(--bone-2); }
  .window__bar span { position: absolute; inset: 0 auto 0 0; width: var(--w); border-radius: inherit; background: linear-gradient(90deg, var(--lilac), var(--shoot)); }
  .window__bar i { position: absolute; top: 50%; width: 20px; height: 20px; border-radius: 50%; background: var(--shoot-deep); border: 4px solid var(--paper); transform: translate(-50%, -50%); box-shadow: var(--shadow); }
  .window__ends { display: flex; justify-content: space-between; font-size: 0.92rem; }
  .window__ends span { display: grid; } .window__ends span:last-child { text-align: right; }
  .window__ends b { font-family: var(--font-mono); font-weight: 500; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
  .clock { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1rem; }
  .clock__lab { font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); font-weight: 600; }
  .clock__v { font-size: clamp(1.1rem, 1rem + 0.6vw, 1.5rem); color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .clock__v b { font-weight: 600; color: var(--text); }
  .ss__cta { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .ss__body { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .facts { display: grid; border-top: 1.5px solid var(--night); }
  .facts div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line-strong); }
  .facts dt { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); padding-top: 0.2rem; }
  .facts dd { font-weight: 600; overflow-wrap: anywhere; }
  .facts a { color: var(--lilac-deep); }
  @media (max-width: 900px) { .ss__grid, .ss__body { grid-template-columns: 1fr; } }
</style>
