---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { ORG } from "../../lib/content";
---
<BaseLayout title="Check your application status" description="Look up the status of your Springrise Foundation scholarship application.">
  <section class="section">
    <div class="container container--narrow status-head">
      <p class="eyebrow reveal" style="justify-content:center;">Scholarships</p>
      <h1 class="h1 reveal" style="margin-top:1rem;">Check your application status</h1>
      <p class="lead reveal" style="margin-top:1rem; margin-inline:auto;">Enter your application reference and the email you applied with. We'll never reveal application documents here — just where things stand.</p>
    </div>

    <div class="container container--narrow">
      <div class="status-card reveal" style="--d:.08s">
        <form id="status-form" novalidate>
          <div class="field">
            <label for="status-ref">Application reference</label>
            <input class="input" id="status-ref" name="reference" type="text" placeholder="SR-S27-XXXXXX" autocomplete="off" required />
          </div>
          <div class="field">
            <label for="status-email">Email you applied with</label>
            <input class="input" id="status-email" name="email" type="email" autocomplete="email" required />
          </div>
          <button class="btn btn--cobalt btn--lg" type="submit">Check status <Icon name="search" size={18} /></button>
          <p class="status-msg" role="status" aria-live="polite" data-status-msg></p>
        </form>

        <div class="status-result" data-status-result hidden>
          <div class="status-result__head">
            <div>
              <p class="label" data-status-season>Season</p>
              <p class="status-result__date muted" data-status-date></p>
            </div>
            <span class="chip" data-status-chip><span class="dot" data-status-dot></span><span data-status-label></span></span>
          </div>
          <p class="status-result__copy" data-status-copy></p>
          <button class="link-arrow" type="button" data-status-again>Check another application <Icon name="arrow" size={16} /></button>
        </div>
      </div>

      <p class="status-footnote muted reveal" style="--d:.12s">
        Status lookups never reveal uploaded documents or reviewer notes. If your status says "needs information," check your email or contact
        {" "}<a href={`mailto:${ORG.emails.scholarship}`}>{ORG.emails.scholarship}</a>.
      </p>

      <a class="link-arrow status-back reveal" href="/scholarships" style="--d:.16s">Back to scholarships <Icon name="arrow" size={16} /></a>
    </div>
  </section>
</BaseLayout>

<style>
  .status-head { text-align: center; max-width: 34rem; }
  .status-card {
    background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 4vw, 2.75rem); box-shadow: var(--shadow); margin-top: clamp(2rem, 4vw, 3rem);
  }
  .status-card form { display: grid; gap: 1.1rem; }
  .status-msg { font-size: 0.9rem; color: var(--danger); min-height: 1.3em; }

  .status-result { margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--line); display: grid; gap: 1.25rem; }
  .status-result__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
  .status-result__date { font-size: 0.9rem; margin-top: 0.3rem; }
  .status-result__copy { line-height: 1.6; color: var(--text-muted); }
  .status-back { margin-top: 2rem; color: var(--cobalt); }

  .dot--received { background: var(--turquoise); }
  .dot--under_review { background: var(--saffron); }
  .dot--needs_information { background: var(--tulip); }
  .dot--awarded { background: #1fb57a; }
  .dot--not_awarded, .dot--withdrawn { background: var(--text-faint); }

  .status-footnote { margin-top: 1.75rem; max-width: 38rem; line-height: 1.6; }
  .status-footnote a { color: var(--cobalt); }
</style>

<script>
  const STATUS_LABELS: Record<string, string> = {
    received: "Received",
    under_review: "Under review",
    needs_information: "Needs information",
    awarded: "Awarded",
    not_awarded: "Not awarded",
    withdrawn: "Withdrawn",
  };
  const STATUS_COPY: Record<string, string> = {
    received: "We've received your application. It's in the queue for the Board's initial review.",
    under_review: "Your application is currently being reviewed by our Board of Directors.",
    needs_information: "We need a bit more information to continue reviewing your application — please check your email, or contact scholarship@springrise.org.",
    awarded: "Congratulations — your scholarship has been awarded. Payment is sent directly to your institution.",
    not_awarded: "This application wasn't selected for an award this season. We encourage you to apply again next season.",
    withdrawn: "This application has been withdrawn.",
  };

  const form = document.getElementById("status-form") as HTMLFormElement | null;
  const msg = document.querySelector<HTMLElement>("[data-status-msg]");
  const result = document.querySelector<HTMLElement>("[data-status-result]");
  const seasonEl = document.querySelector<HTMLElement>("[data-status-season]");
  const dateEl = document.querySelector<HTMLElement>("[data-status-date]");
  const chipEl = document.querySelector<HTMLElement>("[data-status-chip]");
  const dotEl = document.querySelector<HTMLElement>("[data-status-dot]");
  const labelEl = document.querySelector<HTMLElement>("[data-status-label]");
  const copyEl = document.querySelector<HTMLElement>("[data-status-copy]");
  const againBtn = document.querySelector<HTMLButtonElement>("[data-status-again]");

  function fmtDate(iso: string | null | undefined) {
    if (!iso) return "";
    try {
      return new Date(iso).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "America/New_York" });
    } catch {
      return iso;
    }
  }

  function seasonLabel(data: any): string {
    const season = data.season ?? data;
    if (season?.title) return season.title;
    if (season?.term && season?.year) return `${season.term} ${season.year}`;
    if (data.term && data.year) return `${data.term} ${data.year}`;
    return "Your application";
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form) return;
    const btn = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const body = Object.fromEntries(new FormData(form).entries());
    btn?.setAttribute("disabled", "");
    if (msg) msg.textContent = "Checking…";
    if (result) result.hidden = true;
    try {
      const res = await fetch("/api/applications/status", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(body),
      });
      const data = (await res.json().catch(() => ({}))) as Record<string, any>;
      if (!res.ok) throw new Error(data.error || "We couldn't find an application with that reference and email.");

      const status: string = data.status ?? "received";
      if (seasonEl) seasonEl.textContent = seasonLabel(data);
      if (dateEl) dateEl.textContent = `Submitted ${fmtDate(data.submitted_at ?? data.created_at)}`;
      if (dotEl) dotEl.className = `dot dot--${status}`;
      if (labelEl) labelEl.textContent = STATUS_LABELS[status] ?? status;
      if (copyEl) copyEl.textContent = STATUS_COPY[status] ?? "";
      if (msg) msg.textContent = "";
      if (result) result.hidden = false;
    } catch (err) {
      if (msg) msg.textContent = (err as Error).message;
      if (result) result.hidden = true;
    } finally {
      btn?.removeAttribute("disabled");
    }
  });

  againBtn?.addEventListener("click", () => {
    if (result) result.hidden = true;
    if (msg) msg.textContent = "";
    form?.reset();
    document.getElementById("status-ref")?.focus();
  });
</script>
