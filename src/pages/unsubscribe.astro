---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/BaseLayout.astro";
import { verifyUnsubscribeToken } from "../lib/server/email";
import { deleteSubscriberByEmail } from "../lib/server/db";

const email = (Astro.url.searchParams.get("e") || "").trim().toLowerCase();
const token = Astro.url.searchParams.get("t") || "";

// Visiting the link only asks for confirmation (mail scanners pre-open links);
// the subscriber is removed on the confirming POST.
const valid = !!(email && token) && (await verifyUnsubscribeToken(email, token));
let done = false;
if (valid && Astro.request.method === "POST") {
  await deleteSubscriberByEmail(env.DB, email);
  done = true;
}
const ok = valid;
---

<BaseLayout title="Unsubscribe" description="Manage your Springrise Foundation email subscription." noindex={true}>
  <section class="section">
    <div class="container container--narrow unsub-card">
      <p class="eyebrow" style="justify-content:center;">Springrise Foundation</p>
      {ok && !done ? (
        <Fragment>
          <h1 class="h1" style="margin-top:1rem;">Unsubscribe from season emails?</h1>
          <p class="lead" style="margin-inline:auto; margin-top:1rem;">We'll stop sending scholarship season announcements to {email}.</p>
          <form method="post" style="margin-top:1.5rem;">
            <button class="btn btn--cobalt btn--lg" type="submit">Yes, unsubscribe me</button>
          </form>
        </Fragment>
      ) : ok ? (
        <Fragment>
          <h1 class="h1" style="margin-top:1rem;">You're unsubscribed</h1>
          <p class="lead" style="margin-inline:auto; margin-top:1rem;">
            {email} won't receive scholarship season emails from us again. You're welcome to subscribe again any time from the site footer.
          </p>
        </Fragment>
      ) : (
        <Fragment>
          <h1 class="h1" style="margin-top:1rem;">That link isn't valid</h1>
          <p class="lead" style="margin-inline:auto; margin-top:1rem;">
            This unsubscribe link is invalid or has expired. If you'd like to stop receiving emails, contact <a href="mailto:info@springrise.org">info@springrise.org</a>.
          </p>
        </Fragment>
      )}
      <a class:list={["btn btn--lg", done || !ok ? "btn--cobalt" : "btn--ghost"]} href="/" style="margin-top:1.5rem;">Back to the homepage</a>
    </div>
  </section>
</BaseLayout>

<style>
  .unsub-card {
    text-align: center;
    max-width: 34rem;
  }
</style>
