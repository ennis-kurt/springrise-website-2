---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";
import { ORG } from "../lib/content";

const params = Astro.url.searchParams;
const allowedTopics = new Set(["general", "scholarship", "donation", "volunteer", "partnership"]);
const topicParam = params.get("topic");
const presetTopic = topicParam && allowedTopics.has(topicParam) ? topicParam : "general";
const sent = params.get("sent") === "contact";
const errorMsg = params.get("error");

const reachCards = [
  { icon: "mail" as const, label: ORG.emails.info, href: `mailto:${ORG.emails.info}`, note: "General questions about the foundation." },
  { icon: "mail" as const, label: ORG.emails.scholarship, href: `mailto:${ORG.emails.scholarship}`, note: "Scholarship applications and status." },
  { icon: "mail" as const, label: ORG.emails.donation, href: `mailto:${ORG.emails.donation}`, note: "Donations, matching gifts and receipts." },
];
---
<BaseLayout title="Contact" description="Reach the Springrise Foundation team — general questions, scholarships, donations, volunteering and partnerships.">
  <PageHero
    eyebrow="Contact"
    title="Let's talk."
    lead="Whatever brought you here — a question, an idea, a scholarship application — we'd like to hear from you."
    art="none"
  />

  <section class="section section--tight">
    <div class="container">
      {sent && (
        <p class="notice notice--success reveal" role="status">
          <Icon name="check" size={18} /> Thank you — your message has been sent. We'll be in touch soon.
        </p>
      )}
      {errorMsg && (
        <p class="notice notice--error reveal" role="alert">
          <Icon name="info" size={18} /> {errorMsg}
        </p>
      )}

      <div class="contact-grid">
        <div class="reach reveal">
          <p class="eyebrow">Reach us directly</p>
          <div class="reach-card">
            <Icon name="pin" size={20} />
            <address>
              {ORG.legalName}<br />
              {ORG.address.line1}<br />
              {ORG.address.city}, {ORG.address.region} {ORG.address.postal}
            </address>
          </div>
          <div class="reach-card">
            <Icon name="phone" size={20} />
            <a href={ORG.phoneHref}>{ORG.phone}</a>
          </div>
          {reachCards.map((r) => (
            <div class="reach-card">
              <Icon name={r.icon} size={20} />
              <div>
                <a href={r.href}>{r.label}</a>
                <p class="reach-card__note muted">{r.note}</p>
              </div>
            </div>
          ))}
          <p class="reach-note muted">We aim to reply within a few business days.</p>
        </div>

        <div class="form-card reveal" style="--d:.1s">
          <h2 class="h3">Send a message</h2>
          <form id="contact-form" action="/api/contact" method="post" data-ajax data-success="Thank you — your message has been sent. We'll be in touch soon.">
            <div class="honeypot" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
            <div class="field-row">
              <div class="field">
                <label for="c-name">Name</label>
                <input class="input" id="c-name" name="name" type="text" autocomplete="name" required />
              </div>
              <div class="field">
                <label for="c-email">Email</label>
                <input class="input" id="c-email" name="email" type="email" autocomplete="email" required />
              </div>
            </div>
            <div class="field-row">
              <div class="field">
                <label for="c-phone">Phone <small>(optional)</small></label>
                <input class="input" id="c-phone" name="phone" type="tel" autocomplete="tel" />
              </div>
              <div class="field">
                <label for="c-topic">Topic</label>
                <select class="select" id="c-topic" name="topic" required>
                  <option value="general" selected={presetTopic === "general"}>General question</option>
                  <option value="scholarship" selected={presetTopic === "scholarship"}>Scholarship</option>
                  <option value="donation" selected={presetTopic === "donation"}>Donation</option>
                  <option value="volunteer" selected={presetTopic === "volunteer"}>Volunteering</option>
                  <option value="partnership" selected={presetTopic === "partnership"}>Partnership</option>
                </select>
              </div>
            </div>
            <div class="field">
              <label for="c-subject">Subject <small>(optional)</small></label>
              <input class="input" id="c-subject" name="subject" type="text" />
            </div>
            <div class="field">
              <label for="c-message">Message</label>
              <textarea class="textarea" id="c-message" name="message" required></textarea>
            </div>
            <button class="btn btn--cobalt btn--lg" type="submit">Send message <Icon name="arrow" size={18} /></button>
            <p class="form-msg" role="status" aria-live="polite" data-form-msg></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="Applying for a"
    accent="scholarship?"
    body="See eligibility, requirements and open seasons."
    primary={{ href: "/scholarships", label: "View scholarships" }}
    secondary={{ href: "/scholarships/status", label: "Check application status" }}
  />
</BaseLayout>

<style>
  .contact-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; margin-top: 1.5rem; }
  .reach { display: grid; gap: 1.1rem; align-content: start; }
  .reach-card { display: flex; gap: 0.9rem; align-items: flex-start; padding: 1.1rem 1.3rem; background: var(--paper-2); border-radius: var(--radius); }
  .reach-card svg { flex: none; color: var(--cobalt); margin-top: 0.15rem; }
  .reach-card address { font-style: normal; line-height: 1.6; }
  .reach-card a { font-weight: 500; }
  .reach-card__note { font-size: 0.85rem; margin-top: 0.15rem; }
  .reach-note { font-size: 0.9rem; margin-top: 0.5rem; }

  .form-card { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(1.75rem, 3.5vw, 2.75rem); box-shadow: var(--shadow); }
  .form-card form { display: grid; gap: 1.1rem; margin-top: 1.5rem; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  .form-msg { font-size: 0.9rem; color: var(--success); min-height: 1.3em; }
  .form-msg.is-error { color: var(--danger); }
  .notice { margin-bottom: 2rem; max-width: 44rem; }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .field-row { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Preselect topic from ?topic= on client too, in case of cached HTML.
  const params = new URLSearchParams(location.search);
  const topic = params.get("topic");
  const select = document.getElementById("c-topic") as HTMLSelectElement | null;
  if (select && topic && [...select.options].some((o) => o.value === topic)) {
    select.value = topic;
  }
</script>
