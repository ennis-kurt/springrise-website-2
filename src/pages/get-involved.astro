---
import Site from "../layouts/Site.astro";
import PageHead from "../components/PageHead.astro";
import InquiryForm from "../components/InquiryForm.astro";
import { ORG } from "../lib/facts";
const roles = [
  { id: "mentor", tag: "Mentorship", t: "Become a mentor", b: "Share what you've learned — about courses, applications, first jobs, and the questions no syllabus answers — with a student on the path you once walked.", cta: "I'd like to mentor", reason: "mentor" },
  { id: "internships", tag: "Internships", t: "Lead an internship committee", b: "Help us find, coordinate and secure professional internships for our students — or open a role at your own organization.", cta: "I can help with internships", reason: "internships" },
  { id: "board", tag: "Leadership", t: "Join the Board of Trustees", b: "Trustees set the foundation's direction and decide awards each season. They serve three-year terms, without compensation.", cta: "Tell me about the Board", reason: "board" },
  { id: "donor", tag: "Giving", t: "Become a donor", b: "Fund tuition directly. Every scholarship dollar goes straight to a student's school — one semester at a time.", cta: "Ways to give", href: "/give" },
  { id: "spread", tag: "Awareness", t: "Spread the word", b: "Know a student of Turkish descent at a U.S. college who could use support? Share our scholarship page with them.", cta: "Copy scholarship link", copy: "https://springrise.org/scholarships" },
  { id: "partner", tag: "Partnership", t: "Partner with us", b: "Schools, community organizations and companies: let's build training, mentorship and internship programs together.", cta: "Start a conversation", reason: "partnership" },
];
---
<Site title="Get involved" description="Mentor a student, lead an internship committee, join the Board of Trustees, give, or spread the word about Springrise Foundation scholarships.">
  <PageHead kicker="Get involved" title="Lend your time, your network," accent="your judgment." lead="Springrise grows through people. Here's where you can make the biggest difference." />

  <section class="section">
    <div class="wrap">
      <ul class="roles" role="list">
        {roles.map((r, i) => (
          <li class="role rv" id={r.id} style={`--d:${(i % 3) * 0.06}s`}>
            <span class="role__tag mono">{String(i + 1).padStart(2, "0")} · {r.tag}</span>
            <h2 class="t-3 role__t">{r.t}</h2>
            <p class="muted">{r.b}</p>
            {r.href ? <a class="btn btn--line" href={r.href}>{r.cta} <span class="arr">→</span></a>
              : r.copy ? <button class="btn btn--line" type="button" data-copy={r.copy}><span data-copy-label>{r.cta}</span></button>
              : <a class="btn btn--line" href={`#join`} data-reason={r.reason}>{r.cta} <span class="arr">→</span></a>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section night grid-bg" id="join" aria-labelledby="join-h">
    <div class="wrap join">
      <div>
        <p class="kicker rv">Raise your hand</p>
        <h2 class="t-1 rv" id="join-h">Tell us how<br />you'd like to <span class="hl">help.</span></h2>
        <p class="lead rv">We'll reply personally. Prefer email? <a href={`mailto:${ORG.email.info}?subject=Getting%20involved`}>{ORG.email.info}</a></p>
      </div>
      <div class="rv" style="--d:.1s">
        <InquiryForm id="join" night reason="mentor" submit="Send" placeholder="A little about you, and how you'd like to be involved…" reasons={[
          { v: "mentor", label: "Mentoring students" }, { v: "internships", label: "Internships" }, { v: "board", label: "Joining the Board" },
          { v: "partnership", label: "A partnership" }, { v: "giving", label: "Giving" }, { v: "general", label: "Something else" },
        ]} />
      </div>
    </div>
  </section>
</Site>

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-reason]").forEach((a) =>
    a.addEventListener("click", () => {
      const sel = document.getElementById("join-reason") as HTMLSelectElement | null;
      if (sel) sel.value = a.dataset.reason!;
      setTimeout(() => document.querySelector<HTMLInputElement>("#join-name")?.focus({ preventScroll: true }), 500);
    }),
  );
</script>

<style>
  .roles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; }
  .role { display: grid; gap: 1rem; align-content: start; justify-items: start; min-height: 22rem; padding: clamp(1.5rem, 3vw, 2.2rem); border-radius: var(--r-lg); background: var(--paper); border: 1px solid var(--line); scroll-margin-top: 7rem; transition: transform 0.6s var(--ease), box-shadow 0.6s var(--ease); }
  .role:hover { transform: translateY(-6px); box-shadow: var(--shadow); }
  .role:target { outline: 2px solid var(--shoot-deep); }
  .role__tag { font-size: 0.74rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); margin-bottom: auto; padding-bottom: 3rem; }
  .role .btn { margin-top: 0.4rem; }
  .role__t { font-size: clamp(1.6rem, 1.2rem + 1vw, 2.2rem); font-weight: 700; letter-spacing: -0.035em; }
  @media (max-width: 1000px) { .roles { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .roles { grid-template-columns: 1fr; } .role { min-height: 0; } }
  .join { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .join > div:first-child { display: grid; gap: 1.2rem; }
  .join a:not(.btn) { color: var(--shoot); }
  @media (max-width: 900px) { .join { grid-template-columns: 1fr; } }
</style>
