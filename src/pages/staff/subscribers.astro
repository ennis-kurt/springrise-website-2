---
import StaffLayout from "../../layouts/StaffLayout.astro";
import Alert from "../../components/staff/Alert.astro";
import { env } from "cloudflare:workers";
import { countSubscribers, type SubscriberRow } from "../../lib/server/db";
import { formatEt } from "../../lib/server/time";

let notice = Astro.url.searchParams.get("removed") ? "Subscriber removed." : "";
if (Astro.request.method === "POST") {
  const fd = await Astro.request.formData();
  await env.DB.prepare("DELETE FROM subscribers WHERE email = ?1").bind(String(fd.get("email") ?? "")).run();
  return Astro.redirect("/staff/subscribers?removed=1", 303);
}
const q = (Astro.url.searchParams.get("q") ?? "").trim().toLowerCase().slice(0, 100);
const like = `%${q.replace(/[\\%_]/g, (c) => "\\" + c)}%`;
const [total, { results }] = await Promise.all([
  countSubscribers(),
  env.DB.prepare(`SELECT * FROM subscribers ${q ? "WHERE email LIKE ?1 ESCAPE '\\'" : ""} ORDER BY created_at DESC LIMIT 500`)
    .bind(...(q ? [like] : []))
    .all<SubscriberRow>(),
]);
---
<StaffLayout title="Subscribers" active="subscribers">
  <header class="page-head">
    <div>
      <span class="kicker">Subscribers</span>
      <h1>Season updates list</h1>
      <p>{total.toLocaleString("en-US")} {total === 1 ? "person" : "people"} asked to hear when a new season opens.</p>
    </div>
    <a class="btn btn--ghost" href="/api/staff/export/subscribers.csv" download>Export CSV</a>
  </header>
  <Alert ok={notice} />
  <form method="get" class="filters" role="search">
    <label class="field field--grow">
      <span class="lab">Search</span>
      <input type="search" name="q" value={q} placeholder="Email address" maxlength="100" />
    </label>
    <button class="btn btn--primary" type="submit">Search</button>
    {q && <a class="btn btn--ghost" href="/staff/subscribers">Clear</a>}
  </form>
  <div class="table-wrap">
    {results.length ? (
      <table class="table">
        <thead><tr><th scope="col">Email</th><th scope="col">Source</th><th scope="col">Subscribed (ET)</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
        <tbody>
          {results.map((s) => (
            <tr>
              <td><a href={`mailto:${s.email}`}>{s.email}</a></td>
              <td class="mono muted">{s.source}</td>
              <td class="muted">{formatEt(s.created_at, false)}</td>
              <td class="r">
                <form method="post" onsubmit="return confirm('Remove this subscriber?')">
                  <input type="hidden" name="email" value={s.email} />
                  <button class="btn btn--ghost btn--small" type="submit">Remove</button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : <p class="empty">{q ? "No subscribers match." : "No subscribers yet."}</p>}
  </div>
  {results.length === 500 && <p class="hint" style="margin-top:12px">Showing the latest 500. Export the CSV for the full list.</p>}
</StaffLayout>
