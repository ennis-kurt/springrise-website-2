---
import Site from "../layouts/Site.astro";
import PageHead from "../components/PageHead.astro";
import GiftPicker from "../components/viz/GiftPicker.astro";
import InquiryForm from "../components/InquiryForm.astro";
import { FINANCE, GIFTS, ORG } from "../lib/facts";
const money0 = (n: number) => n.toLocaleString("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
---
<Site title="Give" description="Fund tuition for students of Turkish descent in U.S. higher education. Give by Zelle, employer matching through Benevity, bank transfer or check. Springrise is a 501(c)(3) public charity.">
  <PageHead kicker="Give" title="Fund the next" accent="semester." lead={`Every scholarship is paid straight to a student's college or university. In FY 2025, ${(FINANCE.directAid * 100).toFixed(1)}% of what we spent went directly to students.`}>
    <div class="give-hero night">
      <p class="kicker">What your gift becomes</p>
      <GiftPicker night />
    </div>
  </PageHead>

  <section class="section" aria-labelledby="ways-h">
    <div class="wrap">
      <div class="head-row">
        <div>
          <p class="kicker rv">Ways to give</p>
          <h2 class="t-1 rv" id="ways-h">Three ways,<br />all tax-deductible.</h2>
        </div>
        <p class="lead rv">Springrise Foundation, Inc. is a 501(c)(3) public charity (EIN {ORG.ein}). Contributions are tax-deductible under IRC §170 to the extent permitted by law.</p>
      </div>
      <div class="ways">
        <article class="w rv">
          <span class="w__n mono">01</span>
          <h3 class="t-2">Zelle</h3>
          <p class="muted">From your bank's app, send to our Zelle address.</p>
          <dl class="w__dl">
            <div><dt class="mono">Send to</dt><dd>{ORG.zelle.to}</dd></div>
            <div><dt class="mono">Account name</dt><dd>{ORG.zelle.name}</dd></div>
          </dl>
          <button class="btn btn--shoot" type="button" data-copy={ORG.zelle.to}><span data-copy-label>Copy Zelle email</span></button>
        </article>
        <article class="w rv" id="matching" style="--d:.06s">
          <span class="w__n mono">02</span>
          <h3 class="t-2">Employer matching</h3>
          <p class="muted">Springrise is registered on Benevity, the matching hub many employers use — your gift can go twice as far.</p>
          <ol class="w__steps" role="list">
            <li>Give by Zelle, transfer or check.</li>
            <li>Open your employer's giving portal and search for <b>Springrise Foundation</b>.</li>
            <li>Submit your receipt and EIN <b class="mono">{ORG.ein}</b> for a match.</li>
          </ol>
        </article>
        <article class="w rv" style="--d:.12s">
          <span class="w__n mono">03</span>
          <h3 class="t-2">Bank transfer or check</h3>
          <p class="muted">Email us and we'll send bank-transfer details or check instructions.</p>
          <dl class="w__dl">
            <div><dt class="mono">Email</dt><dd><a href={`mailto:${ORG.email.giving}`}>{ORG.email.giving}</a></dd></div>
            <div><dt class="mono">Mail</dt><dd>{ORG.legal}<br />{ORG.address[0]}<br />{ORG.address[1]}</dd></div>
          </dl>
        </article>
      </div>
      <p class="small muted rv soon">Card payments, recurring gifts and Venmo are on the way. Until then, the options above are the fastest routes.</p>
    </div>
  </section>

  <section class="section night grid-bg" aria-labelledby="tiers-h">
    <div class="wrap">
      <div class="head-row">
        <div>
          <p class="kicker rv">Gift levels</p>
          <h2 class="t-1 rv" id="tiers-h">Measured in<br /><span class="hl">semesters.</span></h2>
        </div>
      </div>
      <ul class="tiers" role="list">
        {GIFTS.map((g, i) => (
          <li class="tier rv" style={`--d:${i * 0.08}s; --h:${(g.amount / 12000) * 100}%`}>
            <span class="tier__bar" aria-hidden="true"><i></i></span>
            <span class="tier__amt">{money0(g.amount)}</span>
            <span class="kicker kicker--plain">{g.label}</span>
            <p>{g.line}</p>
          </li>
        ))}
      </ul>
      <p class="small muted rv">Any amount helps — every gift is pooled into the scholarships we award each season.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="ask-h">
    <div class="wrap ask">
      <div>
        <p class="kicker rv">Questions about giving</p>
        <h2 class="t-1 rv" id="ask-h">Let's talk it through.</h2>
        <p class="lead rv">Transfer details, matching paperwork, a gift in someone's honor, or a larger commitment — tell us and we'll follow up personally.</p>
        <a class="link rv" href="/impact">See how gifts were used →</a>
      </div>
      <div class="rv" style="--d:.1s"><InquiryForm id="give" reason="giving" submit="Request information" placeholder="I'd like to set up a matching gift…" /></div>
    </div>
  </section>
</Site>

<style>
  .give-hero { display: grid; gap: 1.2rem; padding: clamp(1.4rem, 3vw, 2.2rem); border-radius: var(--r-lg); background: var(--night-2); border: 1px solid var(--night-line); }
  .ways { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; }
  .w { display: grid; gap: 1rem; align-content: start; justify-items: start; padding: clamp(1.5rem, 3vw, 2.2rem); border-radius: var(--r-lg); background: var(--paper); border: 1px solid var(--line); scroll-margin-top: 7rem; }
  .w__n { font-size: 0.78rem; color: var(--text-muted); margin-bottom: 2.5rem; }
  .w__dl { display: grid; gap: 0.8rem; width: 100%; padding-top: 1rem; border-top: 1px solid var(--line); }
  .w__dl dt { font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); }
  .w__dl dd { font-weight: 600; overflow-wrap: anywhere; }
  .w__dl a { color: var(--lilac-deep); }
  .w__steps { display: grid; gap: 0.6rem; counter-reset: s; padding-top: 1rem; border-top: 1px solid var(--line); }
  .w__steps li { counter-increment: s; display: grid; grid-template-columns: 1.8rem 1fr; }
  .w__steps li::before { content: counter(s); font-family: var(--font-mono); font-size: 0.8rem; color: var(--shoot-ink); padding-top: 0.1rem; }
  .soon { margin-top: 1.4rem; }
  @media (max-width: 1000px) { .ways { grid-template-columns: 1fr; } }

  .tiers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; align-items: end; margin-bottom: 1.4rem; }
  .tier { display: grid; gap: 0.8rem; padding: 1.6rem; border-radius: var(--r-lg); border: 1px solid var(--night-line-strong); }
  .tier__bar { display: flex; align-items: flex-end; height: 11rem; border-radius: var(--r-sm); background: var(--night-2); overflow: hidden; margin-bottom: 0.6rem; }
  .tier__bar i { display: block; width: 100%; height: 0; background: linear-gradient(0deg, var(--shoot-deep), var(--shoot)); border-radius: inherit; transition: height 1.4s var(--ease) calc(var(--d, 0s) + 0.3s); }
  .tier.in .tier__bar i { height: var(--h); }
  .tier__amt { font-family: var(--font-display); font-weight: 750; font-size: clamp(2.4rem, 1.6rem + 2.4vw, 3.8rem); letter-spacing: -0.05em; line-height: 1; }
  .tier p { color: var(--night-muted); }
  @media (max-width: 800px) { .tiers { grid-template-columns: 1fr; } .tier__bar { height: 5rem; } }

  .ask { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .ask > div:first-child { display: grid; gap: 1.2rem; justify-items: start; }
  @media (max-width: 900px) { .ask { grid-template-columns: 1fr; } }
</style>
